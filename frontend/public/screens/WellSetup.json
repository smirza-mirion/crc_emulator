{
  "name": "WellSetup",
  "filename": "WellSetup.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page"
  ],
  "memoryMap": {
    "bytes": {
      "59": "Change Brightness Level",
      "100": "forceUpdate of Volume and Brightness",
      "101": "Initial Volume Level",
      "102": "Initial Brightness Level"
    },
    "words": {
      "100": "Brightness Level"
    }
  },
  "widgets": [
    {
      "type": "StringField",
      "name": "sfTitle",
      "x": 5,
      "y": 0,
      "width": 791,
      "height": 69,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF00",
        "fontColor": "#FFFFFF",
        "fontSize": "24pt",
        "initialCondition": "Well Setup",
        "href": "Amulet:NOP()",
        "printf": "%s"
      },
      "position_from": "title"
    },
    {
      "type": "FunctionButton",
      "name": "btnBack",
      "x": 695,
      "y": 10,
      "width": 100,
      "height": 50,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fontSize": "20pt",
        "fontColor": "blue",
        "fontStyle": "BOLD",
        "label": "Home",
        "href": "%Back"
      },
      "position_from": "back"
    },
    {
      "type": "Image",
      "name": "line1",
      "x": 0,
      "y": 100,
      "width": 800,
      "height": 2,
      "params": {
        "src": "Images/hline2.jpg",
        "invisible": "FALSE"
      },
      "position_from": "line1"
    },
    {
      "type": "Image",
      "name": "line2",
      "x": 0,
      "y": 160,
      "width": 800,
      "height": 2,
      "params": {
        "src": "Images/hline2.jpg",
        "invisible": "FALSE"
      },
      "position_from": "line2"
    },
    {
      "type": "Image",
      "name": "line3",
      "x": 0,
      "y": 220,
      "width": 800,
      "height": 2,
      "params": {
        "src": "Images/hline2.jpg",
        "invisible": "FALSE"
      },
      "position_from": "line3"
    },
    {
      "type": "Slider",
      "name": "sldSaver",
      "x": 220,
      "y": 50,
      "width": 500,
      "height": 40,
      "params": {
        "hrefEvent": "onPenUp",
        "href": "Amulet:NOP()",
        "initialCondition": "0",
        "max": "60",
        "min": "0",
        "minAt": "LEFT",
        "tickCount": "12"
      },
      "position_from": "screen_saver_slider"
    },
    {
      "type": "StringField",
      "name": "sfSaver",
      "x": 730,
      "y": 50,
      "width": 60,
      "height": 35,
      "params": {
        "border": "1",
        "font": "Franklin Gothic Book",
        "fontSize": "14pt",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "initialConditions": "",
        "href": "Amulet:NOP()",
        "printf": "%s",
        "invisible": "FALSE"
      },
      "position_from": "screen_saver_text"
    },
    {
      "type": "Slider",
      "name": "sldBrightness",
      "x": 220,
      "y": 110,
      "width": 500,
      "height": 40,
      "params": {
        "hrefEvent": "onPenUp",
        "href": "Amulet:UART.byte(29).setValue()",
        "hrefOnHitOnly": "TRUE",
        "initialCondition": "FromInitHref",
        "initHref": "Amulet:internalRAM.byte(102).value()",
        "max": "100",
        "min": "10",
        "minAt": "LEFT",
        "tickCount": "10"
      },
      "position_from": "brightness_slider",
      "bindings": [
        {
          "source": "UART",
          "type": "byte",
          "index": 29,
          "param": "href"
        },
        {
          "source": "internalRAM",
          "type": "byte",
          "index": 102,
          "param": "initHref"
        }
      ]
    },
    {
      "type": "StringField",
      "name": "sfBrightness",
      "x": 730,
      "y": 110,
      "width": 60,
      "height": 35,
      "params": {
        "border": "1",
        "font": "Franklin Gothic Book",
        "fontSize": "14pt",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "initialConditions": "",
        "href": "Amulet:NOP()",
        "printf": "%s",
        "invisible": "FALSE"
      },
      "position_from": "brightness_text"
    },
    {
      "type": "Slider",
      "name": "sldVolume",
      "x": 220,
      "y": 170,
      "width": 500,
      "height": 40,
      "params": {
        "hrefEvent": "onChange",
        "href": "Amulet:UART.byte(27).setValue()",
        "hrefOnHitOnly": "TRUE",
        "initialCondition": "FromInitHref",
        "initHref": "Amulet:internalRAM.byte(101).value()",
        "max": "255",
        "min": "0",
        "minAt": "LEFT",
        "tickCount": "10"
      },
      "position_from": "volume_slider",
      "bindings": [
        {
          "source": "UART",
          "type": "byte",
          "index": 27,
          "param": "href"
        },
        {
          "source": "internalRAM",
          "type": "byte",
          "index": 101,
          "param": "initHref"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnVolume",
      "x": 730,
      "y": 170,
      "width": 60,
      "height": 35,
      "params": {
        "font": "Franklin Gothic Book",
        "fontStyle": "BOLD",
        "fontSize": "14pt",
        "fontColor": "Blue",
        "label": "Test",
        "href": "Amulet:UART.word(0).setValue(0x0102)",
        "invisible": "FALSE"
      },
      "position_from": "volume_text",
      "bindings": [
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnAdvanced",
      "x": 20,
      "y": 230,
      "width": 200,
      "height": 40,
      "params": {
        "font": "Franklin Gothic Book",
        "fontStyle": "BOLD",
        "fontSize": "14pt",
        "fontColor": "blue",
        "label": "Advanced",
        "href": "Amulet:document.refreshBrightness.disappear(),%ConfigTitle('Please Enter Passwd:'), %ConfigMaxStrLen(8), %ConfigMaxFractionLen(0), %ConfigMinValue('0.0'), %ConfigMaxValue('0.0'), %ConfigKeypad(%%CONFIG_KEYPAD_PASSWORD), %ConfigPlusMinus_OFF, %SetKeypad(%%SET_KEYPAD_WELL_SETUP_PASSWD)",
        "invisible": "FALSE"
      },
      "position_from": "other_button"
    },
    {
      "type": "Pwm",
      "name": "pwm1",
      "x": 0,
      "y": 0,
      "width": 0,
      "height": 0,
      "params": {
        "channel": "0",
        "initialCondition": "ON",
        "periodIn_ms": ".99",
        "pulseWidthIn_ms": "1"
      },
      "position_from": "pwm"
    }
  ],
  "staticImages": [
    {
      "src": "Images/top_bar.png",
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 69,
      "div_id": "topbar"
    },
    {
      "src": "Images/bottom_bar.png",
      "x": 0,
      "y": 537,
      "width": 800,
      "height": 63,
      "div_id": "bottombar"
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshSliders",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "forceUpdate",
          "target": "sldVolume"
        },
        {
          "type": "forceUpdate",
          "target": "sldBrightness"
        }
      ]
    },
    {
      "name": "refreshBrightness",
      "onVar": "internalRAM.byte(59)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(59)",
          "value": 0
        },
        {
          "type": "setPeriod",
          "target": "pwm1",
          "value": 1
        },
        {
          "type": "raw",
          "expression": "document.pwm1.setPulseWidth(InternalRAM.word(100))"
        },
        {
          "type": "start",
          "target": "pwm1"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_WELL_SETUP"
    }
  ],
  "referencedImages": [
    "Images/bottom_bar.png",
    "Images/hline2.jpg",
    "Images/top_bar.png"
  ],
  "ramUsage": {
    "internalRAM": {
      "bytes": [
        101,
        102
      ]
    },
    "UART": {
      "bytes": [
        27,
        29
      ],
      "words": [
        0
      ]
    }
  }
}