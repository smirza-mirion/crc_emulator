        "fillColor": "#FFFFFF00",
        "fontColor": "#FFFFFF",
        "fontSize": "24pt",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(100).value()",
        "printf": "%s"
      },
      "position_from": "title",
      "bindings": [
        {
          "source": "internalRAM",
