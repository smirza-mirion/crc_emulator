      "type": "FunctionButton",
      "name": "btnAccept",
      "x": 490,
      "y": 542,
      "width": 150,
      "height": 50,
      "params": {
        "label": "FromInitHref",
        "initHref": "Amulet:internalRAM.label(90).value()",
        "horizontalAlign": "CENTER",
        "verticalAlign": "MIDDLE",
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontStyle": "BOLD",
        "fontColor": "green",
        "fillColor": "#FFFFFF",
        "href": "Amulet:document.sfStatus.disappear(),Amulet:document.btnAccept.disappear(), Amulet:document.btnCancel.disappear(), %Beep, Amulet:UART.word(0).setValue(0x0102)",
        "invisible": "FALSE"
      },
