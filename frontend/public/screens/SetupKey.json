{
  "name": "SetupKey",
  "filename": "SetupKey.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page"
  ],
  "memoryMap": {
    "bytes": {
      "100": "Display",
      "101": "Display Status"
    },
    "strings": {
      "90": "Accept",
      "91": "Cancel",
      "100": "Title",
      "101": "DeviceIDLabel",
      "102": "DeviceID",
      "103": "DeviceID",
      "104": "KeyLabel",
      "105": "Key",
      "106": "Key",
      "107": "Status",
      "108": "Status",
      "109": "Please enter Key"
