  "staticImages": [
    {
      "src": "Images/top_bar.png",
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 69,
      "div_id": "topbar"
    },
    {
      "src": "Images/bottom_bar.png",
      "x": 0,
      "y": 537,
      "width": 800,
      "height": 63,
      "div_id": "bottombar"
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshDisplayKey",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "sfTitle"
        },
        {
          "type": "forceUpdate",
          "target": "sfTitle"
        },
        {
          "type": "forceUpdate",
          "target": "sfDeviceIDLabel"
        },
        {
          "type": "forceUpdate",
          "target": "sfDeviceID"
        },
        {
          "type": "forceUpdate",
          "target": "sfKeyLabel"
        },
        {
          "type": "forceUpdate",
          "target": "sfKey"
        },
        {
          "type": "forceUpdate",
          "target": "sfStatus"
        },
        {
          "type": "forceUpdate",
          "target": "btnAccept"
        },
        {
          "type": "forceUpdate",
          "target": "btnCancel"
        }
      ]
    },
    {
      "name": "refreshDisplayStatus",
      "onVar": "internalRAM.byte(101)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(101)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "btnAccept"
        },
        {
          "type": "forceUpdate",
          "target": "btnAccept"
        },
        {
          "type": "reappear",
          "target": "btnCancel"
        },
        {
          "type": "forceUpdate",
          "target": "btnCancel"
        },
        {
          "type": "reappear",
          "target": "sfStatus"
        },
        {
          "type": "forceUpdate",
          "target": "sfStatus"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_SETUP_KEY"
    }
  ],
  "referencedImages": [
    "Images/bottom_bar.png",
    "Images/hline2.jpg",
    "Images/top_bar.png"
  ],
  "ramUsage": {
    "internalRAM": {
      "strings": [
        100,
        101,
        102,
        104,
        105,
        107,
        109
      ],
      "labels": [
        90,
        91
      ]
    },
    "UART": {
      "words": [
        0
      ]
    }
  }
