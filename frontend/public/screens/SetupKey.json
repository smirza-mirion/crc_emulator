        "font": "Franklin Gothic Book",
        "borderColor": "#00000000",
        "label": "",
        "fillColor": "#00000000",
        "href": "%ConfigTitle(Amulet:internalRAM.string(109)), %ConfigMaxStrLen(25), %ConfigKeyboard(%%CONFIG_KEYBOARD_LOCK_UPPER), %HideWildcardChar, %SetKeyboard(%%SET_KEYBOARD_SETUP_KEY)",
        "invisible": "FALSE"
      },
      "position_from": "key",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 109,
          "param": "href"
