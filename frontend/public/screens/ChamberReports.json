        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF00",
        "fontColor": "#FFFFFF",
        "fontSize": "24pt",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(100).value()",
        "printf": "%.51s",
        "invisible": "TRUE"
      },
      "position_from": "title",
      "bindings": [
