{
  "name": "ChamberReports",
  "filename": "ChamberReports.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page"
  ],
  "memoryMap": {
    "bytes": {
      "20": "Show Chamber Label (TOGGLE)",
      "21": "Show Chamber Button (TOGGLE)",
      "80": "Language\t\t(STATE) English = 0, French = 1"
    },
    "strings": {
      "100": "Title",
      "101": "Title",
      "102": "Daily Test",
      "103": "Zero",
      "104": "Background",
      "105": "Chamber Voltage",
      "106": "Accuracy"
    }
  },
