  "staticImages": [
    {
      "src": "Images/top_bar.png",
      "width": 800,
      "height": 69,
      "div_id": "topbar"
    },
    {
      "src": "Images/bottom_bar.png",
      "width": 800,
      "height": 63,
      "div_id": "bottombar"
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshShowHomeEnglish",
      "onVar": "internalRAM.byte(80)",
      "trigger": "0x00",
      "interval": "0.00",
      "actions": [
        {
          "type": "reappear",
          "target": "btnHome"
        }
      ]
    },
    {
      "name": "refreshShowHomeFrench",
      "onVar": "internalRAM.byte(80)",
      "trigger": "0x01",
      "interval": "0.00",
      "actions": [
        {
          "type": "reappear",
          "target": "btnHomeFrench"
        }
      ]
    },
    {
      "name": "refreshShowBackEnglish",
      "onVar": "internalRAM.byte(80)",
      "trigger": "0x00",
      "interval": "0.00",
      "actions": [
        {
          "type": "reappear",
          "target": "btnBack"
        }
      ]
    },
    {
      "name": "refreshShowBackFrench",
      "onVar": "internalRAM.byte(80)",
      "trigger": "0x01",
      "interval": "0.00",
      "actions": [
        {
          "type": "reappear",
          "target": "btnBackFrench"
        }
      ]
    },
    {
      "name": "refreshChambString",
      "onVar": "internalRAM.byte(20)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(20)",
          "value": 0
        },
        {
          "type": "forceUpdate",
          "target": "sfTitle"
        },
        {
          "type": "reappear",
          "target": "sfTitle"
        },
        {
          "type": "forceUpdate",
          "target": "refreshShowHome"
        },
        {
          "type": "forceUpdate",
          "target": "refreshShowBack"
        },
        {
          "type": "forceUpdate",
          "target": "btnDailyTest"
        },
        {
          "type": "forceUpdate",
          "target": "btnZero"
        },
        {
          "type": "forceUpdate",
          "target": "btnBackground"
        },
        {
          "type": "forceUpdate",
          "target": "btnVoltage"
        },
        {
          "type": "forceUpdate",
          "target": "btnAccuracy"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_CHAMBER_REPORTS"
    },
    {
      "type": "forceUpdate",
      "target": "refreshShowHomeEnglish"
    },
    {
      "type": "forceUpdate",
      "target": "refreshShowHomeFrench"
    },
    {
      "type": "forceUpdate",
      "target": "refreshShowBackEnglish"
    },
    {
      "type": "forceUpdate",
      "target": "refreshShowBackFrench"
    }
  ],
  "referencedImages": [
    "Images/back_big.png",
    "Images/bottom_bar.png",
    "Images/french_back_big.png",
    "Images/french_home_big.png",
    "Images/home_big.png",
    "Images/top_bar.png"
  ],
  "hasFrenchVariants": true,
  "ramUsage": {
    "internalRAM": {
      "strings": [
        100
      ],
      "labels": [
        102,
        103,
        104,
        105,
        106
      ]
    }
  }
}