{
  "name": "SetupCalibSerialNum",
  "filename": "SetupCalibSerialNum.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page"
  ],
  "memoryMap": {
    "bytes": {
      "100": "Display Values"
    },
    "strings": {
      "100": "Full Spectrum Efficiency"
    }
  },
  "widgets": [
    {
      "type": "StringField",
      "name": "sfTitle",
      "x": 5,
      "y": 0,
      "width": 791,
      "height": 69,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF00",
        "fontColor": "#FFFFFF",
        "fontSize": "24pt",
        "initialCondition": "Edit Calibrator Serial Number",
        "href": "Amulet:NOP()",
        "printf": "%s"
      },
      "position_from": "title"
    },
    {
      "type": "StringField",
      "name": "sfSerial",
      "x": 350,
      "y": 280,
      "width": 200,
      "height": 40,
      "params": {
        "border": "1",
        "font": "Franklin Gothic Book",
        "fontSize": "14pt",
        "fontColor": "#000000",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "LEFT",
        "fillColor": "#FFFFFF",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(100).value()",
        "printf": "%s",
        "invisible": "FALSE"
      },
      "position_from": "sertext",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 100,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnSerial",
      "x": 350,
      "y": 280,
      "width": 200,
      "height": 40,
      "params": {
        "font": "Franklin Gothic Book",
        "borderColor": "#00000000",
        "label": "",
        "fillColor": "#00000000",
        "href": "%ConfigTitle('Enter Calib Serial#'),%ConfigMaxStrLen(10), %ConfigMaxFractionLen(0), %ConfigMinValue('0.0'), %ConfigMaxValue('0.0'), %ConfigKeypad(%%CONFIG_KEYPAD_DEFAULT), %ConfigPlusMinus_OFF,%SetKeypad(%%SET_KEYPAD_CALIB_SERIAL)",
        "invisible": "FALSE"
      },
      "position_from": "sertext"
    },
    {
      "type": "FunctionButton",
      "name": "btnAccept",
      "x": 483,
      "y": 538,
      "width": 154,
      "height": 62,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fontSize": "18pt",
        "fontColor": "green",
        "fontStyle": "BOLD",
        "label": "Accept",
        "href": "Amulet:document.btnAccept.disappear(), Amulet:UART.word(0).setValue(0x0102)",
        "invisible": "FALSE"
      },
      "position_from": "accept",
      "bindings": [
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnCancel",
      "x": 641,
      "y": 538,
      "width": 154,
      "height": 62,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fontSize": "18pt",
        "fontColor": "red",
        "fontStyle": "BOLD",
        "label": "Cancel",
        "href": "Amulet:document.btnCancel.disappear(), %Back",
        "invisible": "FALSE"
      },
      "position_from": "cancel"
    }
  ],
  "staticImages": [
    {
      "src": "Images/top_bar.png",
      "width": 800,
      "height": 69,
      "div_id": "topbar"
    },
    {
      "src": "Images/bottom_bar.png",
      "width": 800,
      "height": 63,
      "div_id": "bottombar"
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshShow",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "forceUpdate",
          "target": "sfSerial"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_EDIT_CALIB_SERIAL"
    }
  ],
  "referencedImages": [
    "Images/bottom_bar.png",
    "Images/top_bar.png"
  ],
  "ramUsage": {
    "internalRAM": {
      "strings": [
        100
      ]
    },
    "UART": {
      "words": [
        0
      ]
    }
  }
}