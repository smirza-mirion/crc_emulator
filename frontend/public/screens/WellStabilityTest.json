{
  "name": "WellStabilityTest",
  "filename": "WellStabilityTest.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page"
  ],
  "widgets": [
    {
      "type": "StringField",
      "name": "sfTitle",
      "x": 5,
      "y": 0,
      "width": 791,
      "height": 69,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF00",
        "fontColor": "#FFFFFF",
        "fontSize": "24pt",
        "initialCondition": "Well Stability Test",
        "href": "Amulet:NOP()",
        "printf": "%s"
      },
      "position_from": "title"
    },
    {
      "type": "CustomButton",
      "name": "btnHome",
      "x": 8,
      "y": 13,
      "width": 100,
      "height": 50,
      "params": {
        "label": "",
        "href": "%Home",
        "onButtonPress": "GRAY",
        "upImage": "Images/home_big.png",
        "downImage": "Images/home_big.png",
        "repeatRate": "0.00",
        "invisible": "FALSE"
      },
      "position_from": "home"
    },
    {
      "type": "CustomButton",
      "name": "btnBack",
      "x": 693,
      "y": 13,
      "width": 100,
      "height": 50,
      "params": {
        "label": "",
        "href": "%Back",
        "onButtonPress": "GRAY",
        "upImage": "Images/back_big.png",
        "downImage": "Images/back_big.png",
        "repeatRate": "0.00",
        "invisible": "FALSE"
      },
      "position_from": "back"
    },
    {
      "type": "StringField",
      "name": "sfCountTime",
      "x": 570,
      "y": 85,
      "width": 200,
      "height": 40,
      "params": {
        "border": "1",
        "font": "Franklin Gothic Book",
        "fontSize": "14pt",
        "fontStyle": "BOLD",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "verticalAlign": "MIDDLE",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(101).value()",
        "printf": "%s",
        "invisible": "FALSE"
      },
      "position_from": "counttimetext",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 101,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnCountTime",
      "x": 570,
      "y": 85,
      "width": 200,
      "height": 40,
      "params": {
        "font": "Franklin Gothic Book",
        "borderColor": "#00000000",
        "label": "",
        "fillColor": "#00000000",
        "href": "%ConfigTitle('Please Enter Counting Time (sec):'), %ConfigMaxStrLen(4), %ConfigMaxFractionLen(0), %ConfigMinValue('1.0'), %ConfigMaxValue('9999.0'), %ConfigKeypad(%%CONFIG_KEYPAD_DEFAULT), %ConfigPlusMinus_OFF, %SetKeypad(%%SET_KEYPAD_WELL_STABILITY_TIME)",
        "invisible": "FALSE"
      },
      "position_from": "counttimetext"
    },
    {
      "type": "StringField",
      "name": "sfReps",
      "x": 570,
      "y": 135,
      "width": 200,
      "height": 40,
      "params": {
        "border": "1",
        "font": "Franklin Gothic Book",
        "fontSize": "14pt",
        "fontStyle": "BOLD",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "verticalAlign": "MIDDLE",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(102).value()",
        "printf": "%s",
        "invisible": "FALSE"
      },
      "position_from": "repstext",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 102,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnReps",
      "x": 570,
      "y": 135,
      "width": 200,
      "height": 40,
      "params": {
        "font": "Franklin Gothic Book",
        "borderColor": "#00000000",
        "label": "",
        "fillColor": "#00000000",
        "href": "%ConfigTitle('Please Enter Number of Samples:'), %ConfigMaxStrLen(6), %ConfigMaxFractionLen(0), %ConfigMinValue('2.0'), %ConfigMaxValue('100000.0'), %ConfigKeypad(%%CONFIG_KEYPAD_DEFAULT), %ConfigPlusMinus_OFF, %SetKeypad(%%SET_KEYPAD_WELL_STABILITY_REPS)",
        "invisible": "FALSE"
      },
      "position_from": "repstext"
    },
    {
      "type": "FunctionButton",
      "name": "btnMeasure",
      "x": 570,
      "y": 185,
      "width": 200,
      "height": 40,
      "params": {
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontColor": "blue",
        "fontStyle": "BOLD",
        "label": "Measure Cs137",
        "href": "Amulet:UART.word(0).setValue(0x0102)",
        "invisible": "TRUE"
      },
      "position_from": "measure",
      "bindings": [
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "StringField",
      "name": "sfLabel",
      "x": 0,
      "y": 185,
      "width": 800,
      "height": 40,
      "params": {
        "border": "0",
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontStyle": "BOLD",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "verticalAlign": "TOP",
        "horizontalAlign": "LEFT",
        "initialCondition": "Please wait saving data to SD Card",
        "href": "Amulet:NOP()",
        "printf": "%s",
        "invisible": "TRUE"
      },
      "position_from": "label"
    },
    {
      "type": "StringField",
      "name": "sf1",
      "x": 0,
      "y": 235,
      "width": 800,
      "height": 40,
      "params": {
        "border": "0",
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontStyle": "BOLD",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "verticalAlign": "TOP",
        "horizontalAlign": "LEFT",
        "initialCondition": "Done. Data is in stable.csv on the SD Card",
        "href": "Amulet:NOP()",
        "printf": "%s",
        "invisible": "TRUE"
      },
      "position_from": "1"
    }
  ],
  "staticImages": [
    {
      "src": "Images/top_bar.png",
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 69,
      "div_id": "topbar"
    },
    {
      "src": "Images/bottom_bar.png",
      "x": 0,
      "y": 537,
      "width": 800,
      "height": 63,
      "div_id": "bottombar"
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshShow",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "forceUpdate",
          "target": "sfCountTime"
        },
        {
          "type": "forceUpdate",
          "target": "sfReps"
        }
      ]
    },
    {
      "name": "refreshShowButton",
      "onVar": "internalRAM.byte(101)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(101)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "btnMeasure"
        }
      ]
    },
    {
      "name": "refreshShowWait",
      "onVar": "internalRAM.byte(102)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(102)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "sfLabel"
        }
      ]
    },
    {
      "name": "refreshShowFinish",
      "onVar": "internalRAM.byte(103)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(103)",
          "value": 0
        },
        {
          "type": "disappear",
          "target": "sfLabel"
        },
        {
          "type": "reappear",
          "target": "sf1"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_WELL_STABILITY_TEST"
    }
  ],
  "referencedImages": [
    "Images/back_big.png",
    "Images/bottom_bar.png",
    "Images/home_big.png",
    "Images/top_bar.png"
  ],
  "ramUsage": {
    "internalRAM": {
      "strings": [
        101,
        102
      ]
    },
    "UART": {
      "words": [
        0
      ]
    }
  }
}