{
  "name": "Login",
  "filename": "Login.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page"
  ],
  "memoryMap": {
    "bytes": {
      "100": "Show Display"
    },
    "strings": {
      "100": "UserName",
      "101": "Password"
    }
  },
  "widgets": [
    {
      "type": "StringField",
      "name": "sfTitle",
      "x": 5,
      "y": 0,
      "width": 791,
      "height": 69,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF00",
        "fontColor": "#FFFFFF",
        "fontSize": "24pt",
        "initialCondition": "Login",
        "href": "Amulet:NOP()",
        "printf": "%s"
      },
      "position_from": "title"
    },
    {
      "type": "CustomButton",
      "name": "btnUsername",
      "x": 300,
      "y": 150,
      "width": 320,
      "height": 40,
      "params": {
        "upImage": "Images/320x40.png",
        "downImage": "Images/320x40.png",
        "horizontalAlign": "LEFT",
        "verticalAlign": "MIDDLE",
        "onButtonPress": "ALPHA",
        "buttonType": "SPRING-LOADED",
        "font": "Franklin Gothic Book",
        "fontColor": "#000000",
        "fontSize": "14pt",
        "fontStyle": "PLAIN",
        "alphaColor": "#000000FF",
        "label": "FromInitHref",
        "initHref": "Amulet:internalRAM.label(100).value()",
        "noSdram": "TRUE",
        "repeatDelay": "0.01",
        "repeatRate": "0.00",
        "href": "%ConfigTitle('Please enter Username:'), %ConfigMaxStrLen(13), %ConfigKeyboard(%%CONFIG_KEYBOARD_LOCK_LOWER), %HideWildcardChar, %SetKeyboard(%%SET_KEYBOARD_LOGIN_USERNAME)",
        "invisible": "TRUE"
      },
      "position_from": "username_text",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "label",
          "index": 100,
          "param": "initHref"
        }
      ]
    },
    {
      "type": "CustomButton",
      "name": "btnPassword",
      "x": 300,
      "y": 220,
      "width": 320,
      "height": 40,
      "params": {
        "upImage": "Images/320x40.png",
        "downImage": "Images/320x40.png",
        "horizontalAlign": "LEFT",
        "verticalAlign": "MIDDLE",
        "onButtonPress": "ALPHA",
        "buttonType": "SPRING-LOADED",
        "font": "Franklin Gothic Book",
        "fontColor": "#000000",
        "fontSize": "14pt",
        "fontStyle": "PLAIN",
        "alphaColor": "#000000FF",
        "label": "FromInitHref",
        "initHref": "Amulet:internalRAM.label(101).value()",
        "noSdram": "TRUE",
        "repeatDelay": "0.01",
        "repeatRate": "0.00",
        "href": "%ConfigTitle('Please enter Password:'), %ConfigMaxStrLen(13), %ConfigKeyboard(%%CONFIG_KEYBOARD_LOCK_LOWER), %HideWildcardChar, %SetKeyboard(%%SET_KEYBOARD_LOGIN_PASSWORD)",
        "invisible": "TRUE"
      },
      "position_from": "password_text",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "label",
          "index": 101,
          "param": "initHref"
        }
      ]
    },
    {
      "type": "StringField",
      "name": "sfOverrideCode",
      "x": 300,
      "y": 290,
      "width": 320,
      "height": 40,
      "params": {
        "border": "0",
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontColor": "#000000",
        "fontStyle": "PLAIN",
        "fillColor": "#FFFFFF",
        "horizontalAlign": "LEFT",
        "verticalAlign": "MIDDLE",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(102).value()",
        "printf": "%s",
        "updateRate": "0.00",
        "invisible": "TRUE"
      },
      "position_from": "override_code",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 102,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnGuest",
      "x": 5,
      "y": 544,
      "width": 250,
      "height": 50,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fontSize": "18pt",
        "fontColor": "green",
        "fontStyle": "BOLD",
        "label": "Login as Guest",
        "href": "Amulet:document.btnGuest.disappear(),Amulet:UART.word(0).setValue(0x0102)",
        "invisible": "TRUE"
      },
      "position_from": "guest",
      "bindings": [
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnAccept",
      "x": 483,
      "y": 544,
      "width": 154,
      "height": 50,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fontSize": "18pt",
        "fontColor": "green",
        "fontStyle": "BOLD",
        "label": "Accept",
        "href": "Amulet:document.btnAccept.disappear(),Amulet:UART.word(0).setValue(0x0103)",
        "invisible": "TRUE"
      },
      "position_from": "accept",
      "bindings": [
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnCancel",
      "x": 641,
      "y": 544,
      "width": 154,
      "height": 50,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fontSize": "18pt",
        "fontColor": "red",
        "fontStyle": "BOLD",
        "label": "Cancel",
        "href": "Amulet:document.btnCancel.disappear(),%Back",
        "invisible": "TRUE"
      },
      "position_from": "cancel"
    }
  ],
  "staticImages": [
    {
      "src": "Images/top_bar.png",
      "width": 800,
      "height": 69,
      "div_id": "topbar"
    },
    {
      "src": "Images/bottom_bar.png",
      "width": 800,
      "height": 63,
      "div_id": "bottombar"
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshShowDisplay",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "forceUpdate",
          "target": "btnUsername"
        },
        {
          "type": "reappear",
          "target": "btnUsername"
        },
        {
          "type": "forceUpdate",
          "target": "btnPassword"
        },
        {
          "type": "reappear",
          "target": "btnPassword"
        },
        {
          "type": "reappear",
          "target": "btnGuest"
        },
        {
          "type": "reappear",
          "target": "btnAccept"
        },
        {
          "type": "reappear",
          "target": "btnCancel"
        }
      ]
    },
    {
      "name": "refreshShowDisplayExceptForGuest",
      "onVar": "internalRAM.byte(101)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(101)",
          "value": 0
        },
        {
          "type": "forceUpdate",
          "target": "btnUsername"
        },
        {
          "type": "reappear",
          "target": "btnUsername"
        },
        {
          "type": "forceUpdate",
          "target": "btnPassword"
        },
        {
          "type": "reappear",
          "target": "btnPassword"
        },
        {
          "type": "reappear",
          "target": "btnAccept"
        },
        {
          "type": "reappear",
          "target": "btnCancel"
        }
      ]
    },
    {
      "name": "refreshShowOverride",
      "onVar": "internalRAM.byte(102)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(102)",
          "value": 0
        },
        {
          "type": "forceUpdate",
          "target": "sfOverrideCode"
        },
        {
          "type": "reappear",
          "target": "sfOverrideCode"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_LOGIN"
    }
  ],
  "referencedImages": [
    "Images/320x40.png",
    "Images/bottom_bar.png",
    "Images/top_bar.png"
  ],
  "ramUsage": {
    "internalRAM": {
      "strings": [
        102
      ],
      "labels": [
        100,
        101
      ]
    },
    "UART": {
      "words": [
        0
      ]
    }
  }
}