{
  "name": "Chamber",
  "filename": "Chamber.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page",
    "GrayLCD.Page"
  ],
  "memoryMap": {
    "bytes": {
      "100": "Show Select Chamber (0xFF)"
    },
    "words": {
      "101": "Background X",
      "102": "Background Y",
      "103": "Title X",
      "104": "Title Y",
      "105": "Button 1 X",
      "106": "Button 1 Y",
      "107": "Button 2 X",
      "108": "Button 2 Y"
    },
    "strings": {
      "100": "Button 1 Label",
      "101": "Button 2 Label",
      "102": "Select Chamber",
      "103": "Select Chamber",
      "104": "Cancel"
    }
  },
  "widgets": [
    {
      "type": "StringField",
      "name": "sfTitle",
      "x": 5,
      "y": 0,
      "width": 790,
      "height": 60,
      "params": {
        "border": "0",
        "fillColor": "#000030",
        "horizontalAlign": "LEFT",
        "verticalAlign": "BOTTOM",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(102).value()",
        "printf": "%.51s",
        "font": "Franklin Gothic Book",
        "fontSize": "20pt",
        "fontColor": "#FFFF30",
        "fontStyle": "BOLD",
        "updateRate": "0.0",
        "invisible": "TRUE"
      },
      "position_from": "title",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 102,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btn1",
      "x": 200,
      "y": 180,
      "width": 400,
      "height": 70,
      "params": {
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontColor": "blue",
        "fontStyle": "BOLD",
        "fillColor": "#FFFFFF",
        "label": "fromInitHref",
        "initHref": "Amulet:InternalRAM.label(100).value()",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "href": "Amulet:UART.word(0).setValue(0x0102)",
        "invisible": "TRUE"
      },
      "position_from": "b1",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "label",
          "index": 100,
          "param": "initHref"
        },
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btn2",
      "x": 200,
      "y": 350,
      "width": 400,
      "height": 70,
      "params": {
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontColor": "blue",
        "fontStyle": "BOLD",
        "fillColor": "#FFFFFF",
        "label": "fromInitHref",
        "initHref": "Amulet:internalRAM.label(101).value()",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "href": "Amulet:UART.word(0).setValue(0x0103)",
        "invisible": "TRUE"
      },
      "position_from": "b2",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "label",
          "index": 101,
          "param": "initHref"
        },
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnCancel",
      "x": 641,
      "y": 533,
      "width": 154,
      "height": 62,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fontSize": "18pt",
        "fontColor": "red",
        "fontStyle": "BOLD",
        "label": "FromInitHref",
        "initHref": "Amulet:internalRAM.label(104).value()",
        "href": "Amulet:document.btnCancel.disappear(),%Back",
        "invisible": "TRUE"
      },
      "position_from": "cancel",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "label",
          "index": 104,
          "param": "initHref"
        }
      ]
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshShowNotification",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "sfTitle"
        },
        {
          "type": "forceUpdate",
          "target": "sfTitle"
        },
        {
          "type": "reappear",
          "target": "btn1"
        },
        {
          "type": "forceUpdate",
          "target": "btn1"
        },
        {
          "type": "reappear",
          "target": "btn2"
        },
        {
          "type": "forceUpdate",
          "target": "btn2"
        },
        {
          "type": "reappear",
          "target": "btnCancel"
        },
        {
          "type": "forceUpdate",
          "target": "btnCancel"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_SELECT_CHAMBER"
    }
  ],
  "ramUsage": {
    "internalRAM": {
      "strings": [
        102
      ],
      "labels": [
        100,
        101,
        104
      ]
    },
    "UART": {
      "words": [
        0
      ]
    }
  }
}