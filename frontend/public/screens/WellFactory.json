{
  "name": "WellFactory",
  "filename": "WellFactory.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page"
  ],
  "widgets": [
    {
      "type": "StringField",
      "name": "sfTitle",
      "x": 5,
      "y": 0,
      "width": 791,
      "height": 69,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF00",
        "fontColor": "#FFFFFF",
        "fontSize": "24pt",
        "initialCondition": "Detector Settings",
        "href": "Amulet:NOP()",
        "printf": "%s"
      },
      "position_from": "title"
    },
    {
      "type": "StringField",
      "name": "sfSerial",
      "x": 400,
      "y": 75,
      "width": 200,
      "height": 50,
      "params": {
        "border": "1",
        "font": "Franklin Gothic Book",
        "fontSize": "16pt",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "verticalAlign": "MIDDLE",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(100).value()",
        "printf": "%s",
        "invisible": "FALSE"
      },
      "position_from": "serialtext",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 100,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnSerial",
      "x": 400,
      "y": 75,
      "width": 200,
      "height": 50,
      "params": {
        "font": "Franklin Gothic Book",
        "borderColor": "#00000000",
        "label": "",
        "fillColor": "#00000000",
        "href": "%ConfigTitle('Enter Well Serial#'),%ConfigMaxStrLen(6),%ConfigMaxFractionLen(0),%ConfigMinValue('0.0'),%ConfigMaxValue('0.0'),%ConfigKeypad(%%CONFIG_KEYPAD_DEFAULT), %ConfigPlusMinus_OFF,%SetKeypad(%%SET_KEYPAD_WELL_SERIAL)",
        "invisible": "FALSE"
      },
      "position_from": "serialtext"
    },
    {
      "type": "StringField",
      "name": "sfHV",
      "x": 400,
      "y": 145,
      "width": 200,
      "height": 50,
      "params": {
        "border": "1",
        "font": "Franklin Gothic Book",
        "fontSize": "16pt",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "verticalAlign": "MIDDLE",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(101).value()",
        "printf": "%s",
        "invisible": "FALSE"
      },
      "position_from": "hvtext",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 101,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnHV",
      "x": 400,
      "y": 145,
      "width": 200,
      "height": 50,
      "params": {
        "font": "Franklin Gothic Book",
        "borderColor": "#00000000",
        "label": "",
        "fillColor": "#00000000",
        "href": "%ConfigTitle('Enter Well Voltage:'),%ConfigMaxStrLen(4),%ConfigMaxFractionLen(0),%ConfigMinValue('595.0'),%ConfigMaxValue('1246.0'),%ConfigKeypad(%%CONFIG_KEYPAD_DEFAULT), %ConfigPlusMinus_OFF,%SetKeypad(%%SET_KEYPAD_WELL_VOLTAGE)",
        "invisible": "FALSE"
      },
      "position_from": "hvtext"
    },
    {
      "type": "StringField",
      "name": "sfThreshold",
      "x": 400,
      "y": 215,
      "width": 200,
      "height": 50,
      "params": {
        "border": "1",
        "font": "Franklin Gothic Book",
        "fontSize": "16pt",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "verticalAlign": "MIDDLE",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(103).value()",
        "printf": "%s",
        "invisible": "FALSE"
      },
      "position_from": "thresholdtext",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 103,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnThreshold",
      "x": 400,
      "y": 215,
      "width": 200,
      "height": 50,
      "params": {
        "font": "Franklin Gothic Book",
        "borderColor": "#00000000",
        "label": "",
        "fillColor": "#00000000",
        "href": "%ConfigTitle('Enter Threshold'),%ConfigMaxStrLen(4),%ConfigMaxFractionLen(0),%ConfigMinValue('0.0'),%ConfigMaxValue('4095.0'),%ConfigKeypad(%%CONFIG_KEYPAD_DEFAULT), %ConfigPlusMinus_OFF,%SetKeypad(%%SET_KEYPAD_WELL_THRESHOLD)",
        "invisible": "FALSE"
      },
      "position_from": "thresholdtext"
    },
    {
      "type": "FunctionButton",
      "name": "btnAccept",
      "x": 490,
      "y": 542,
      "width": 150,
      "height": 50,
      "params": {
        "label": "Accept",
        "horizontalAlign": "CENTER",
        "verticalAlign": "MIDDLE",
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontStyle": "BOLD",
        "fontColor": "green",
        "fillColor": "#FFFFFF",
        "href": "Amulet:document.btnAccept.disappear(),Amulet:UART.word(0).setValue(0x0102)",
        "invisible": "FALSE"
      },
      "position_from": "accept",
      "bindings": [
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnCancel",
      "x": 645,
      "y": 542,
      "width": 150,
      "height": 50,
      "params": {
        "label": "Cancel",
        "horizontalAlign": "CENTER",
        "verticalAlign": "MIDDLE",
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontStyle": "BOLD",
        "fontColor": "red",
        "fillColor": "#FFFFFF",
        "href": "Amulet:document.btnCancel.disappear(), %Back",
        "invisible": "FALSE"
      },
      "position_from": "cancel"
    }
  ],
  "staticImages": [
    {
      "src": "Images/top_bar.png",
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 69,
      "div_id": "topbar"
    },
    {
      "src": "Images/bottom_bar.png",
      "x": 0,
      "y": 537,
      "width": 800,
      "height": 63,
      "div_id": "bottombar"
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshDisplay",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "forceUpdate",
          "target": "sfSerial"
        },
        {
          "type": "forceUpdate",
          "target": "sfHV"
        },
        {
          "type": "forceUpdate",
          "target": "sfThreshold"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_WELL_FACTORY"
    }
  ],
  "referencedImages": [
    "Images/bottom_bar.png",
    "Images/top_bar.png"
  ],
  "ramUsage": {
    "internalRAM": {
      "strings": [
        100,
        101,
        103
      ]
    },
    "UART": {
      "words": [
        0
      ]
    }
  }
}