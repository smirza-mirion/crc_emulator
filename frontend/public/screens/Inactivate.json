{
  "name": "Inactivate",
  "filename": "Inactivate.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page"
  ],
  "memoryMap": {
    "bytes": {
      "100": "Show Screen"
    },
    "strings": {
      "100": "Comment",
      "101": "Title",
      "102": "Title",
      "103": "Question",
      "104": "Question",
      "105": "Comment Label",
      "106": "Please enter Comment:",
      "107": "Please enter Comment:",
      "108": "YES",
      "109": "NO"
    }
  },
  "widgets": [
    {
      "type": "StringField",
      "name": "sfTitle",
      "x": 5,
      "y": 0,
      "width": 791,
      "height": 69,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF00",
        "fontColor": "#FFFFFF",
        "fontSize": "24pt",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(101).value()",
        "printf": "%.51s",
        "invisible": "TRUE"
      },
      "position_from": "title",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 101,
          "param": "href"
        }
      ]
    },
    {
      "type": "StringField",
      "name": "sfCommentLabel",
      "x": 0,
      "y": 100,
      "width": 150,
      "height": 40,
      "params": {
        "border": "0",
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontColor": "#000000",
        "fillColor": "#FFFFFF",
        "fontStyle": "ITALIC|BOLD",
        "initialCondition": "",
        "horizontalAlign": "RIGHT",
        "verticalAlign": "MIDDLE",
        "href": "Amulet:internalRAM.string(105).value()",
        "printf": " %s",
        "invisible": "TRUE"
      },
      "position_from": "comment_title",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 105,
          "param": "href"
        }
      ]
    },
    {
      "type": "CustomButton",
      "name": "btnComment",
      "x": 150,
      "y": 100,
      "width": 380,
      "height": 40,
      "params": {
        "upImage": "Images/380x40.png",
        "downImage": "Images/380x40.png",
        "horizontalAlign": "LEFT",
        "verticalAlign": "MIDDLE",
        "onButtonPress": "ALPHA",
        "buttonType": "SPRING-LOADED",
        "font": "Franklin Gothic Book",
        "fontColor": "#000000",
        "fontSize": "14pt",
        "fontStyle": "PLAIN",
        "alphaColor": "#000000FF",
        "label": "FromInitHref",
        "initHref": "Amulet:internalRAM.label(100).value()",
        "noSdram": "TRUE",
        "repeatDelay": "0.01",
        "repeatRate": "0.00",
        "href": "%ConfigTitle(Amulet:internalRAM.string(106)), %ConfigMaxStrLen(22), %ConfigKeyboard(%%CONFIG_KEYBOARD_TEMP_UPPER), %HideWildcardChar, %SetKeyboard(%%SET_KEYBOARD_INACTIVATE_COMMENT)",
        "invisible": "TRUE"
      },
      "position_from": "comment",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "label",
          "index": 100,
          "param": "initHref"
        },
        {
          "source": "internalRAM",
          "type": "string",
          "index": 106,
          "param": "href"
        }
      ]
    },
    {
      "type": "StringField",
      "name": "sfQuestion",
      "x": 50,
      "y": 200,
      "width": 650,
      "height": 40,
      "params": {
        "border": "0",
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "LEFT",
        "fillColor": "#FFFFFF",
        "fontColor": "#000000",
        "fontSize": "24pt",
        "fontStyle": "ITALIC|BOLD",
        "initialCondition": "",
        "href": "Amulet:internalRAM.string(103).value()",
        "printf": "%.51s",
        "invisible": "TRUE"
      },
      "position_from": "question",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 103,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnYes",
      "x": 50,
      "y": 250,
      "width": 140,
      "height": 50,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fontSize": "18pt",
        "fontColor": "green",
        "fontStyle": "BOLD",
        "label": "FromInitHref",
        "initHref": "Amulet:internalRAM.label(108).value()",
        "href": "Amulet:document.btnYes.disappear(), Amulet:UART.word(0).setValue(0x0102)",
        "invisible": "TRUE"
      },
      "position_from": "yes",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "label",
          "index": 108,
          "param": "initHref"
        },
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnNo",
      "x": 250,
      "y": 250,
      "width": 140,
      "height": 50,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fontSize": "18pt",
        "fontColor": "red",
        "fontStyle": "BOLD",
        "label": "FromInitHref",
        "initHref": "Amulet:internalRAM.label(109).value()",
        "href": "Amulet:document.btnNo.disappear(), Amulet:UART.word(0).setValue(0x0103)",
        "invisible": "TRUE"
      },
      "position_from": "no",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "label",
          "index": 109,
          "param": "initHref"
        },
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    }
  ],
  "staticImages": [
    {
      "src": "Images/top_bar.png",
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 69,
      "div_id": "topbar"
    },
    {
      "src": "Images/bottom_bar.png",
      "x": 0,
      "y": 537,
      "width": 800,
      "height": 63,
      "div_id": "bottombar"
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshShow",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "forceUpdate",
          "target": "sfTitle"
        },
        {
          "type": "reappear",
          "target": "sfTitle"
        },
        {
          "type": "forceUpdate",
          "target": "sfCommentLabel"
        },
        {
          "type": "reappear",
          "target": "sfCommentLabel"
        },
        {
          "type": "forceUpdate",
          "target": "btnComment"
        },
        {
          "type": "reappear",
          "target": "btnComment"
        },
        {
          "type": "forceUpdate",
          "target": "sfQuestion"
        },
        {
          "type": "reappear",
          "target": "sfQuestion"
        },
        {
          "type": "forceUpdate",
          "target": "btnYes"
        },
        {
          "type": "reappear",
          "target": "btnYes"
        },
        {
          "type": "forceUpdate",
          "target": "btnNo"
        },
        {
          "type": "reappear",
          "target": "btnNo"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_INACTIVATE"
    }
  ],
  "referencedImages": [
    "Images/380x40.png",
    "Images/bottom_bar.png",
    "Images/top_bar.png"
  ],
  "ramUsage": {
    "internalRAM": {
      "strings": [
        101,
        103,
        105,
        106
      ],
      "labels": [
        100,
        108,
        109
      ]
    },
    "UART": {
      "words": [
        0
      ]
    }
  }
}