{
  "name": "Ethernet",
  "filename": "Ethernet.htm",
  "resolution": {
    "width": 800,
    "height": 600
  },
  "directives": [
    "ReloadInternalRAM.Page"
  ],
  "widgets": [
    {
      "type": "StringField",
      "name": "sfTitle",
      "x": 5,
      "y": 0,
      "width": 791,
      "height": 69,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF00",
        "fontColor": "#FFFFFF",
        "fontSize": "24pt",
        "initialCondition": "Test Ethernet",
        "href": "Amulet:NOP()",
        "printf": "%s"
      },
      "position_from": "title"
    },
    {
      "type": "CustomButton",
      "name": "btnHome",
      "x": 8,
      "y": 13,
      "width": 100,
      "height": 50,
      "params": {
        "label": "",
        "href": "Amulet:UART.byte(5).setValue(7)",
        "onButtonPress": "GRAY",
        "upImage": "Images/home_big.png",
        "downImage": "Images/home_big.png",
        "repeatRate": "0.00",
        "invisible": "FALSE"
      },
      "position_from": "home",
      "bindings": [
        {
          "source": "UART",
          "type": "byte",
          "index": 5,
          "param": "href"
        }
      ]
    },
    {
      "type": "CustomButton",
      "name": "btnBack",
      "x": 693,
      "y": 13,
      "width": 100,
      "height": 50,
      "params": {
        "label": "",
        "href": "Amulet:UART.byte(5).setValue(6)",
        "onButtonPress": "GRAY",
        "upImage": "Images/back_big.png",
        "downImage": "Images/back_big.png",
        "repeatRate": "0.00",
        "invisible": "FALSE"
      },
      "position_from": "back",
      "bindings": [
        {
          "source": "UART",
          "type": "byte",
          "index": 5,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnSend",
      "x": 100,
      "y": 100,
      "width": 200,
      "height": 70,
      "params": {
        "label": "Send Packets",
        "horizontalAlign": "CENTER",
        "verticalAlign": "MIDDLE",
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontColor": "blue",
        "fontStyle": "BOLD",
        "fillColor": "#FFFFFF",
        "href": "Amulet:document.btnSend.disappear(), Amulet:document.btnMirror.disappear(), Amulet:UART.word(0).setValue(0x0102)",
        "invisible": "TRUE"
      },
      "position_from": "send",
      "bindings": [
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "FunctionButton",
      "name": "btnMirror",
      "x": 100,
      "y": 200,
      "width": 200,
      "height": 70,
      "params": {
        "label": "Echo Packets",
        "horizontalAlign": "CENTER",
        "verticalAlign": "MIDDLE",
        "font": "Franklin Gothic Book",
        "fontSize": "18pt",
        "fontColor": "blue",
        "fontStyle": "BOLD",
        "fillColor": "#FFFFFF",
        "href": "Amulet:document.btnSend.disappear(), Amulet:document.btnMirror.disappear(), Amulet:UART.word(0).setValue(0x0103)",
        "invisible": "TRUE"
      },
      "position_from": "mirror",
      "bindings": [
        {
          "source": "UART",
          "type": "word",
          "index": 0,
          "param": "href"
        }
      ]
    },
    {
      "type": "StringField",
      "name": "sfSend",
      "x": 100,
      "y": 300,
      "width": 600,
      "height": 70,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF",
        "fontColor": "#000000",
        "fontSize": "24pt",
        "initialCondition": "",
        "href": "Amulet:NOP()",
        "printf": "Sending Packets%s",
        "invisible": "TRUE"
      },
      "position_from": "sendlabel"
    },
    {
      "type": "StringField",
      "name": "sfMirror",
      "x": 100,
      "y": 300,
      "width": 600,
      "height": 70,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF",
        "fontColor": "#000000",
        "fontSize": "24pt",
        "initialCondition": "",
        "href": "Amulet:NOP()",
        "printf": "Echoing Packets%s",
        "invisible": "TRUE"
      },
      "position_from": "mirrorlabel"
    },
    {
      "type": "StringField",
      "name": "sfCount",
      "x": 100,
      "y": 400,
      "width": 600,
      "height": 70,
      "params": {
        "font": "Franklin Gothic Book",
        "verticalAlign": "MIDDLE",
        "horizontalAlign": "CENTER",
        "fillColor": "#FFFFFF",
        "fontColor": "#000000",
        "fontSize": "24pt",
        "initialCondition": "",
        "href": "Amulet:InternalRAM.string(100).value()",
        "printf": "%s",
        "updateRate": "1.0",
        "invisible": "FALSE"
      },
      "position_from": "count",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 100,
          "param": "href"
        }
      ]
    }
  ],
  "staticImages": [
    {
      "src": "Images/top_bar.png",
      "width": 800,
      "height": 69,
      "div_id": "topbar"
    },
    {
      "src": "Images/bottom_bar.png",
      "width": 800,
      "height": 63,
      "div_id": "bottombar"
    }
  ],
  "refreshTriggers": [
    {
      "name": "refreshShowSendButton",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "btnSend"
        }
      ]
    },
    {
      "name": "refreshShowMirrorButton",
      "onVar": "internalRAM.byte(101)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(101)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "btnMirror"
        }
      ]
    },
    {
      "name": "refreshShowSendMessage",
      "onVar": "internalRAM.byte(102)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(102)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "sfSend"
        }
      ]
    },
    {
      "name": "refreshShowMirrorMessage",
      "onVar": "internalRAM.byte(103)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(103)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "sfMirror"
        }
      ]
    }
  ],
  "initActions": [
    {
      "type": "macro",
      "macro": "SetScreen",
      "args": "%%SCREEN_ETHERNET"
    }
  ],
  "referencedImages": [
    "Images/back_big.png",
    "Images/bottom_bar.png",
    "Images/home_big.png",
    "Images/top_bar.png"
  ],
  "ramUsage": {
    "internalRAM": {
      "strings": [
        100
      ]
    },
    "UART": {
      "bytes": [
        5
      ],
      "words": [
        0
      ]
    }
  }
}