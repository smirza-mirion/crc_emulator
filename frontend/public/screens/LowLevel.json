  "refreshTriggers": [
    {
      "name": "refreshShowMode",
      "onVar": "internalRAM.byte(100)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(100)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "sfMode"
        },
        {
          "type": "forceUpdate",
          "target": "sfMode"
        }
      ]
    },
    {
      "name": "refreshShowClearButton",
      "onVar": "internalRAM.byte(101)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(101)",
          "value": 0
        },
        {
          "type": "reappear",
          "target": "btnClear"
        }
      ]
    },
    {
      "name": "refreshShowMemStatus",
      "onVar": "internalRAM.byte(102)",
      "trigger": "0xFF",
      "interval": "0.01",
      "actions": [
        {
          "type": "setValue",
          "target": "internalRAM.byte(102)",
