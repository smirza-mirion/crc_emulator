          "type": "setValue",
          "target": "internalRAM.byte(104)",
          "value": 0
        },
        {
          "type": "disappear",
          "target": "btnMemTestOff"
        },
        {
          "type": "reappear",
          "target": "btnMemTestOn"
        },
        {
          "type": "reappear",
          "target": "btnOff"
        },
        {
          "type": "reappear",
          "target": "btnChamber"
        },
        {
          "type": "reappear",
          "target": "btnWell"
        },
        {
          "type": "reappear",
          "target": "btnClear"
        },
        {
          "type": "reappear",
          "target": "btnAccept"
        },
        {
          "type": "reappear",
          "target": "btnCancel"
        },
        {
