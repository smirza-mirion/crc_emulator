        {
          "type": "disappear",
          "target": "btnOff"
        },
        {
          "type": "disappear",
          "target": "btnChamber"
        },
        {
          "type": "disappear",
          "target": "btnWell"
        },
        {
          "type": "disappear",
          "target": "btnClear"
        },
        {
          "type": "disappear",
          "target": "btnAccept"
        },
        {
          "type": "disappear",
          "target": "btnCancel"
        },
        {
          "type": "disappear",
          "target": "sfMode"
        },
        {
          "type": "reappear",
          "target": "btnMemTestOff"
        }
