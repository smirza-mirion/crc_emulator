        "printf": "Low Level Debug Mode: %.51s",
        "invisible": "FALSE"
      },
      "position_from": "mode",
      "bindings": [
        {
          "source": "internalRAM",
          "type": "string",
          "index": 100,
          "param": "href"
        }
      ]
