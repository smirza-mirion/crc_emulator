/* ind_mset.68: ANSI memset() function, optimized for 68000 family. */

/* DO NOT ADD ANYTHING TO THIS FUNCTION WHICH MIGHT RELY ON GLOBAL VARIABLES. */
/* This function is used during initialization, before global state is safe.  */

#if defined(EMBEDDED)  || (defined(CHORUS) && defined(__ELF))

#if defined(__GHS_UNDERSCORE)
#define memset _memset
#endif

	FILE	"ind_mset.68"
	SECT	.text,x
	OPT	NOLC			; do not assume _symbol is local

	XDEF	memset

memset:
	MOVE.L	D2,-(SP)
	MOVE.L	8(SP),A0		; void *s
	MOVEQ	#0,D0
	MOVE.B	15(SP),D0		; unsigned char c
	MOVE.L	16(SP),D1		; size_t n
	BLE.S	done			; disallow huge copies or empty copies
	CMPI.L	#8,D1			; Always byte copy small ranges
	BLT.S	trailloop	
precopy:				; copy enough bytes to align A0 to 4 byte boundary
	MOVE.L	A0,D2
	ANDI.L	#3,D2
	BEQ.S	longcopy
	MOVE.B	D0,(A0)+
	SUBQ.L	#1,D1
	BRA.S	precopy
	
longcopy:				; copy 8 bytes at a time
	SUBQ.L	#8,D1
	BLT.S	postcopy
	MOVE.L	D0,D2
	ASL.L	#8,D2
	OR.L	D0,D2
	MOVE.L	D2,D0
	SWAP.W	D2
	OR.L	D0,D2
loop:
	MOVE.L	D2,(A0)+
	MOVE.L	D2,(A0)+
	SUBQ.L	#8,D1
	BGE.S	loop

postcopy:				; copy any trailing bytes
	ADDQ.L	#8,D1
trailloop:	
	BEQ.S	done
	MOVE.B	D0,(A0)+
	SUBQ.L	#1,D1
	BRA.S	trailloop
	
done:
	MOVE.L	8(SP),D0		; return s;
	MOVE.L	(SP)+,D2
	RTS

	END

#elif defined(__sun)
	.comm	__G_empty_file_illegal,4
#endif
