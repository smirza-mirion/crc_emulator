/* ind_dots.68: .syscall section for 68000 family */

#if defined(EMBEDDED)

	FILE	"ind_dots.68"
	SECT	.syscall,x

	OPT	NOLC		* do not assume _symbol is local

	XDEF	__dotsyscall
__dotsyscall:
	NOP			* the debugger puts a special breakpoint here
	JMP	(A0)

	END

#endif
