#!gbuild
[Library]
	:sourceDir=../../src/libsys
	-I../../src/libsys
	-ansi
	--incorrect_pragma_warnings
	--unknown_pragma_warnings
	--prototype_warnings
	--diag_error 236
	--no_coverage_analysis
	-check=nomemory
	-fnone
	-pnone
ind_crt1.c
	{optional} -no_parameter_check
	{optional} -globalreg=99
ind_io.c
ind_alrm.c
ind_bcnt.c
ind_call.gpj		[Select One]
ind_dots.gpj		[Select One]
ind_errn.c
ind_exit.c
	-gtws
ind_gcnt.gpj		[Select One]
prof_960.c
prof_mip.c
ind_gmtm.c
ind_gpid.c
ind_gprf.c
	{optional} -no_16bit_data_pointer
ind_heap.c
ind_alloc.c
ind_iob.c
ind_mcnt.gpj		[Select One]
ind_mprf.c
ind_renm.c
ind_sgnl.c
	-gtws
ind_stat.c
ind_syst.c
ind_thrd.c
ind_time.c
ind_tmzn.c
ind_trnc.c
ind_sock.c
ind_manprf.c
ppc_manprf.h
mip_manprf.h
arm_manprf.h
ind_sock.h
indsyscl.h
ind_io.h
indos.h
ind_crt1.h
ind_heap.h
ind_thrd.h
ind_targ1.gpj		[Select One]
