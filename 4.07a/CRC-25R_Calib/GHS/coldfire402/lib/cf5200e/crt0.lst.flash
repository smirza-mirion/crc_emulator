                           155	; Clear the frame pointer so stack traces terminate nicely
00000000 9dce              156		SUBA.L	A6,A6			; smaller than move.w 0,a6
                           157	;
                           158	; First order of business is to detect whether or not the debugger ran us.
                           159	; We do that by making a special system call that does not use the stack.
                           160	; The code to do this is a carbon copy of the sequence in __ghs_syscall.
                           161	; If it returns with the carry clear then somebody caught the system call.
                           162	; Otherwise we must set the stack pointer and the PID base ourselves.
00000002 7214              163		MOVEQ	#20,D1
00000004 41fa0000          164		LEA	didsyscall(PC),A0
00000008 7000              165		MOVEQ	#0,D0			; return -1, errno=0 if no host
0000000a 44fc0001          166		MOVE	#1,CCR			; set carry
0000000e 227c00000000      167	lab1:	MOVE.L	#__dotsyscall-lab1,A1	; 68000 PIC-safe jump to __dotsyscall
00000014 4efb98f8          168		JMP	lab1(PC,A1.L)		; branch with link in A0
                           169	didsyscall:
                           170	;	
                           171	; *****************************************************************************
                           172	; *****************************************************************************
                           173	;
                           174	;	Clive: Basically do Register Setup like mpserv_standard.mbs
                           175	;
00000018 303c7000          176		move.w #SYNTH_INIT,d0		;Clock Synthesizer Control Register
0000001c 33c040120000      177		move.w d0,SYNCR
                           178	;
00000022 7000              179		move.l #0x0,d0			;Init Cache Register - turn off cache
00000024 4e7b0002          180		movec.l d0,CACR
                           181	;
00000028 203c20000001      182		move.l #0x20000001,d0		;Setup RAMBAR to point at SRAMBASE
0000002e 4e7b0c05          183		movec.l d0,RAMBAR
                           184	;
00000032 203c20000000      185		move.l #0x20000000,d0		;Setup Vector Base
00000038 4e7b0801          186		movec.l d0,VBR
                           187	;
0000003c 203c00000121      188		move.l #0x00000121,d0		;Setup FLASHBAR
00000042 4e7b0c04          189		movec.l d0,FLASHBAR
                           190	;
00000046 103c00e0          191		move.b #0xe0,d0			;allow A21-A23 to be enabled
0000004a 13c040100051      192		move.b d0,PFPAR
                           193	;
00000050 103c00ff          194		move.b #0xff,d0			;allow BS3-BS0 and CS3-CS0 to be enabled
00000054 13c040100054      195		move.b d0,PJPAR
                           196	;
0000005a 303c555f          197		move.w #0x555f,d0		;allow BUS SIGNALS to be enabled
0000005e 33c040100052      198		move.w d0,PEPAR
                           199	;
00000064 303c0000          200		move.w #0x0000,d0		;Turn Off Watchdog Timer
00000068 33c040140000      201		move.w d0,WCR
                           202	

