                           203	;
                           204	
                           205	;
                           206	; SDRAM Initialization Here
                           207	;
                           208	; Ref: MCF5282UM, Section 15.3.6 for SDRAM Example Setup
                           209	;
0000006e 103c0080          210		move.b #0x80,d0			;SDRAM Size=16-bit
00000072 13c040100050      211		move.b d0,PBCDPAR
                           212	;	
00000078 303c023f          213		move.w #0x023F,d0		;See MCF5282UM Table 15-4
0000007c 33c040000040      214		move.w d0,SDCR
                           215	;
00000082 203c02001320      216		move.l #0x02001320,d0		;Disable SDRAM Controller
00000088 23c040000048      217		move.l d0,DACR0
                           218	;
0000008e 203c007c0001      219		move.l #0x007C0001,d0		;SDRAM Mode
00000094 23c04000004c      220		move.l d0,DMR0
                           221	;
0000009a 203c02001328      222		move.l #0x02001328,d0		;Send PreCharge Command (PALL)
000000a0 23c040000048      223		move.l d0,DACR0
                           224	;
000000a6 303c0000          225		move.w #0x0,d0
000000aa 33c002000000      226		move.w d0,0x02000000		;Write to SDRAM to Init PreCharge
                           227	;	
000000b0 203c02009320      228		move.l #0x02009320,d0		;Enable Refresh Command (Disable PreCharge)
000000b6 23c040000048      229		move.l d0,DACR0
                           230	;
                           231	; Wait awhile for Refresh to Happen
000000bc 7200              232		move.l #0,d1
                           233	waitref:
000000be 5281              234		add.l #1,d1
000000c0 0c8100200000      235		cmp.l #0x200000,d1		;Clive: NOTE: Tune to reduce startup time later
000000c6 66f6              236		bne waitref
                           237	;
000000c8 203c02009360      238		move.l #0x02009360,d0		;Issue MRS Command (IMRS)
000000ce 23c040000048      239		move.l d0,DACR0
                           240	;
000000d4 303c0000          241		move.w #0x0,d0
000000d8 33c002000800      242		move.w d0,0x02000800		;Initiate MRS Command by writing to address
                           243	;					 corresponding to CAS Latency
                           244	;
000000de 7200              245		move.l #0,d1
                           246	waitmrs:
000000e0 5281              247		add.l #1,d1
000000e2 0c8100080000      248		cmp.l #0x80000,d1		;Clive: Wait for mrs to take effect
000000e8 66f6              249		bne waitmrs
                           250	;
                           251	;
                           252	; Copy the Vector Table from ROM into Vector RAM
                           253	;
000000ea 7200              254		move.l #0,d1			;Init d1 counter
000000ec 207c00000000      255		move.l #0,a0			;Flash Base in a0
000000f2 227c20000000      256		move.l #VBR_INIT,a1		;VBR Base in a1
                           257	nexvec:
000000f8 22d8              258		move.l (A0)+,(A1)+		;copy the longword

