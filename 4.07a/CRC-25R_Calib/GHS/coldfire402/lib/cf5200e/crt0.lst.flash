                           278	;
                           279	
                           280	
                           281	
00000114 4bf900000000      282		LEA	__ghsbegin_sdabase,A5	; .sdabase section in link map, used for PID and SDA
                           283	
0000011a 42a7              284		CLR.L	-(SP)			; push 0 value for envp
0000011c 42a7              285		CLR.L	-(SP)			; push 0 value for argv
0000011e 42a7              286		CLR.L	-(SP)			; push 0 value for argc
00000120 598f              287		SUBQ.L	#4,SP			; make space for return address
00000122 41fa0000          288		LEA	croak(PC),A0
                           289	regs_okay:
00000126 43fa0000          290		LEA	baseptrs(PC),A1
0000012a 2e89              291		MOVE.L	A1,(SP)			; overwrite return address
                           292	
                           293	; Setup SDA/PID base pointer for signed offsets - not supported on COFF
                           294	
0000012c dbfc00008000      295		ADDA.L	#$8000,A5
                           296	
                           297	
                           298		
                           299	; Initialize potential global registers 
00000132 243c00000000      300		MOVE.L	#__ghs_init_d2,D2
00000138 263c00000000      301		MOVE.L	#__ghs_init_d3,D3
0000013e 283c00000000      302		MOVE.L	#__ghs_init_d4,D4
00000144 2a3c00000000      303		MOVE.L	#__ghs_init_d5,D5
                           304		
                           305	; Arrange to handle the case where exit(main(...)) returns to us. (!!)
                           306	; If we are under the debugger, hang (loop forever) so we can be halted.
                           307	; If we are not under the debugger, croak (force a double bus fault).
                           308	; The default _exit() function usually prevents this case from happening.
0000014a 2f08              309		MOVE.L	A0,-(SP)		; give ind_crt0 our chosen return addr
                           310	
                           311	
                           312	; Now do 68000 PIC-safe transfer to C startup routine (ind_crt0.c)
0000014c 207c00000000      313	lab2:	MOVE.L	#__ghs_ind_crt0-lab2,A0
00000152 4efb88f8          314		JMP	lab2(PC,A0.L)

