                                   Tue Jul 20 14:07:37 2004          crt0.68
000000fa 5281              259		add.l #1,d1
000000fc 0c8100000040      260		cmp.l #0x40,d1			;64 Longword Vectors
00000102 66f4              261		bne nexvec
