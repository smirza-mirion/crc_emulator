#!gbuild
[Program]
	-memory
	-keepmap
	-Ma
	-Mx
	--signed_chars
	--signed_pointer
	--unsigned_enum_fields
	--short_enum
	--struct_min_alignment=2
	-pack=4
	-align4
	-strict_overlap_check
	-checksum
	-clearstack
	-nooverload
	-o halt
	-I.\headers
	-DCRC_R
	-G
	-check=nomemory
	-Ospeed
	--long_long
HaltMain.c
standalone_ram.ld
crc_25r.map
