
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		<META NAME="Amulet" CONTENT="GrayLCD.Page">
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0, 0.01; URL=%SetScreen(%%SCREEN_STUDY2); NAME=refreshInit">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x00;URL=Amulet:document.radioNone.reappear(),
														    Amulet:document.radioBone.reappear(),
														    Amulet:document.radioLung.reappear(),
														    Amulet:document.radioHIDA.reappear(),
														    Amulet:document.radioHeart.reappear(),
														    Amulet:document.radioRenal.reappear(),
														    Amulet:document.radioLiver.reappear(),
														    Amulet:document.radioBrain.reappear(),
														    Amulet:document.radioLymph.reappear();
														    NAME=refreshShowEnglishRadio">
														
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x01;URL=Amulet:document.radioNoneFrench.reappear(),
														    Amulet:document.radioBoneFrench.reappear(),
														    Amulet:document.radioLungFrench.reappear(),
														    Amulet:document.radioHIDAFrench.reappear(),
														    Amulet:document.radioHeartFrench.reappear(),
														    Amulet:document.radioRenalFrench.reappear(),
														    Amulet:document.radioLiverFrench.reappear(),
														    Amulet:document.radioBrainFrench.reappear(),
														    Amulet:document.radioLymphFrench.reappear();
														    NAME=refreshShowFrenchRadio">
														    
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTitle.forceUpdate(),
														     Amulet:document.sfTitle.reappear(),
														     Amulet:document.refreshShowEnglishRadio.forceUpdate(),
														     Amulet:document.refreshShowFrenchRadio.forceUpdate();
														     NAME=refreshShowAll">
		
		<style type="text/css">
			#backgnd {position:absolute;left:380;top:240;width:0;height:0}
			#none {position:absolute;left:400;top:290;width:0;height:0}
			#bone {position:absolute;left:400;top:340;width:0;height:0}
			#lung {position:absolute;left:400;top:390;width:0;height:0}
			#hida {position:absolute;left:400;top:440;width:0;height:0}
			#heart {position:absolute;left:400;top:490;width:0;height:0}
			
			#renal {position:absolute;left:550;top:290;width:0;height:0}
			#liver {position:absolute;left:550;top:340;width:0;height:0}
			#brain {position:absolute;left:550;top:390;width:0;height:0}
			#lymph {position:absolute;left:550;top:440;width:0;height:0}
		</style>
	