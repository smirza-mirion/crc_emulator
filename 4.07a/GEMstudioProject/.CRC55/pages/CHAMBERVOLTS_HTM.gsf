
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0, 0.01; URL=%SetScreen(%%SCREEN_CHAMBERVOLTS); NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;URL=Amulet:document.refreshShowHomeEnglish.forceUpdate(),
							    Amulet:document.refreshShowHomeFrench.forceUpdate();
							    NAME=refreshShowHome">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x00;URL=Amulet:document.btnHome.reappear();
														    NAME=refreshShowHomeEnglish">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x01;URL=Amulet:document.btnHomeFrench.reappear();
														    NAME=refreshShowHomeFrench">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;URL=Amulet:document.refreshHideHomeEnglish.forceUpdate(),
							    Amulet:document.refreshHideHomeFrench.forceUpdate();
							    NAME=refreshHideHome">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x00;URL=Amulet:document.btnHome.disappear();
														    NAME=refreshHideHomeEnglish">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x01;URL=Amulet:document.btnHomeFrench.disappear();
														    NAME=refreshHideHomeFrench">
														    
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;URL=Amulet:document.refreshShowBackEnglish.forceUpdate(),
							    Amulet:document.refreshShowBackFrench.forceUpdate();
							    NAME=refreshShowBack">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x00;URL=Amulet:document.btnBack.reappear();
														    NAME=refreshShowBackEnglish">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x01;URL=Amulet:document.btnBackFrench.reappear();
														    NAME=refreshShowBackFrench">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;URL=Amulet:document.refreshHideBackEnglish.forceUpdate(),
							    Amulet:document.refreshHideBackFrench.forceUpdate();
							    NAME=refreshHideBack">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x00;URL=Amulet:document.btnBack.disappear();
														    NAME=refreshHideBackEnglish">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x01;URL=Amulet:document.btnBackFrench.disappear();
														    NAME=refreshHideBackFrench">
														    
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(20).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(20).setValue(0),
														    Amulet:document.sfTitle.forceUpdate(),
														    Amulet:document.sfTitle.reappear(),
														    Amulet:document.refreshShowHome.forceUpdate(),
														    Amulet:document.refreshShowBack.forceUpdate(),
														    Amulet:document.sfChamberVolts.forceUpdate(),
													    	    Amulet:document.sfChamb.reappear(),
														    Amulet:document.sfChamb.forceUpdate();
														    NAME=refreshChambString">
	
		<!--META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(21).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(21).setValue(0),
														    Amulet:document.btnChamb.reappear();
														    NAME=refreshChambButton"-->
														    
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(189).value();TRIGGER=0xFF;URL=Amulet:internalRam.byte(189).setValue(0),Amulet:document.barChamberVolts.setUpdateRate(0.5),Amulet:document.barChamberVolts.startUpdating(),Amulet:document.barChamberVolts.reappear(),Amulet:document.refreshChamberVoltsBar.disappear();NAME=refreshChamberVoltsBar">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(189).value();TRIGGER=0xFE;URL=Amulet:internalRam.byte(189).setValue(0),Amulet:document.barChamberVolts.disappear(),Amulet:document.sfChamberVoltsResult.setUpdateRate(0.5),Amulet:document.sfChamberVoltsResult.startUpdating(),Amulet:document.sfChamberVoltsResult.reappear(),Amulet:document.line1.reappear(),Amulet:document.refreshChamberVoltsResult.disappear();NAME=refreshChamberVoltsResult">
		
		<!--META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRam.byte(100).setValue(0),
														     Amulet:document.btnHome.disappear(),
