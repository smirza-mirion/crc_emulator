														     Amulet:document.sfDummy2.reappear(),
														     Amulet:document.sfDummy2.forceUpdate();
														     NAME=refreshDisappearButtons"-->
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRam.byte(100).setValue(0),
														     Amulet:document.refreshHideHome.forceUpdate(),
														     Amulet:document.refreshHideBack.forceUpdate(),
														     Amulet:document.sfDummy2.reappear(),
														     Amulet:document.sfDummy2.forceUpdate();
														     NAME=refreshDisappearButtons">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRam.byte(101).setValue(0),
														     Amulet:document.refreshShowHome.forceUpdate(),
														     Amulet:document.refreshShowBack.forceUpdate(),
														     Amulet:document.sfDummy2.forceUpdate(),
														     Amulet:document.sfDummy2.disappear();
														     NAME=refreshShowBackButton">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(109).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(109).setValue(0),
													     Amulet:document.sfChamberVoltsResult.inverseStringColor();
													     NAME=refreshShowRedChamberResult">
		
