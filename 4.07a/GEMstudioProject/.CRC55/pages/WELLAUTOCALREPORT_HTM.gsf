
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_AUTOCAL_REPORT);NAME=refreshInit">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTestTime.forceUpdate(),
														     Amulet:document.sfSerialNum.forceUpdate(),
														     Amulet:document.sfThreshold.forceUpdate(),
														     Amulet:document.sfHV.forceUpdate(),
														     Amulet:document.sfGain.forceUpdate(),
														     Amulet:document.sfZero.forceUpdate(),
														     Amulet:document.sfFWHM.forceUpdate(),
														     Amulet:document.sfDetector.forceUpdate(),
														     Amulet:document.sfChannels.forceUpdate(),
														     Amulet:document.btnBack.reappear();
														     Name=refreshShow">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnBack.reappear(),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrint">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														     Amulet:document.sfLinearity.reappear(),
														     Amulet:document.sfLinearity1.forceUpdate(),
														     Amulet:document.sfLinearity1.reappear(),
														     Amulet:document.sfLinearity2.forceUpdate(),
														     Amulet:document.sfLinearity2.reappear(),
														     Amulet:document.sfLinearity3.forceUpdate(),
														     Amulet:document.sfLinearity3.reappear(),
														     Amulet:document.sfLinearity4.forceUpdate(),
														     Amulet:document.sfLinearity4.reappear(),
														     Amulet:document.sfLinearity5.forceUpdate(),
														     Amulet:document.sfLinearity5.reappear();
														     NAME=refreshShowLinearity">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(103).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(103).setValue(0),
														     Amulet:document.sfFWHMLipLabel.reappear(),
														     Amulet:document.sfFWHMLip.forceUpdate(),
														     Amulet:document.sfFWHMLip.reappear();
														     NAME=refreshShowFWHMLip">
		
