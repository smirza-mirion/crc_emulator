			#backgnd1 {position:absolute;left:0;top:61;width:800;height:518}
			#topbar {position:absolute;left:0;top:0;height:0;width:0}
			#bottombar {position:absolute;left:0;top:537;height:0;width:0}
			#title {position:absolute;left:5;top:0;width:0;height:0}
			#username_label {position:absolute;left:0;top:150;width:0;height:0}
			#username_text {position:absolute;left:300;top:150;width:0;height:0}
			#password_label {position:absolute;left:0;top:220;width:0;height:0}
			#password_text {position:absolute;left:300;top:220;width:0;height:0}
