
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_PLASMA);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfDetector.forceUpdate(),
														     Amulet:document.sfBackgroundLabel.forceUpdate(),
														     Amulet:document.btnBackground.forceUpdate(),
														     Amulet:document.btnBackground.reappear(),
														     Amulet:document.btnDil.forceUpdate(),
														     Amulet:document.btnDil.reappear(),
														     Amulet:document.btnSampleVol.forceUpdate(),
														     Amulet:document.btnSampleVol.reappear(),
														     Amulet:document.btnHCT.forceUpdate(),
														     Amulet:document.btnHCT.reappear(),
														     Amulet:document.btnPatWeight.forceUpdate(),
														     Amulet:document.btnPatWeight.reappear(),
														     Amulet:document.btnStandardMeasurement.forceUpdate(),
														     Amulet:document.btnStandardMeasurement.reappear(),
														     Amulet:document.btnWholeMeasurement.forceUpdate(),
														     Amulet:document.btnWholeMeasurement.reappear(),
														     Amulet:document.btnPlasmaMeasurement.forceUpdate(),
														     Amulet:document.btnPlasmaMeasurement.reappear();
														     NAME=refreshShow">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnCalculate.reappear();
														     NAME=refreshShowCalculate">
		
