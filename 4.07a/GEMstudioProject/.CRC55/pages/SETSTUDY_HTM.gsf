
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		<META NAME="Amulet" CONTENT="GrayLCD.Page">
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0, 0.01; URL=%SetScreen(%%SCREEN_STUDY); NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x00;URL=Amulet:document.radioNone.reappear(),
														    Amulet:document.radioBone.reappear(),
														    Amulet:document.radioLung.reappear(),
														    Amulet:document.radioHIDA.reappear(),
														    Amulet:document.radioHeart.reappear(),
														    Amulet:document.radioRenal.reappear(),
														    Amulet:document.radioLiver.reappear(),
														    Amulet:document.radioBrain.reappear(),
														    Amulet:document.radioLymph.reappear();
														    NAME=refreshShowEnglishRadio">
														
		<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0x01;URL=Amulet:document.radioNoneSpanish.reappear(),
														    Amulet:document.radioBoneSpanish.reappear(),
														    Amulet:document.radioLungSpanish.reappear(),
														    Amulet:document.radioHIDASpanish.reappear(),
														    Amulet:document.radioHeartSpanish.reappear(),
														    Amulet:document.radioRenalSpanish.reappear(),
														    Amulet:document.radioLiverSpanish.reappear(),
														    Amulet:document.radioBrainSpanish.reappear(),
														    Amulet:document.radioLymphSpanish.reappear();
														    NAME=refreshShowSpanishRadio">
														
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTitle.forceUpdate(),
														     Amulet:document.sfTitle.reappear(),
														     Amulet:document.refreshShowEnglishRadio.forceUpdate(),
														     Amulet:document.refreshShowSpanishRadio.forceUpdate();
														     NAME=refreshShowAll">
														
		<style type="text/css">
			#backgnd {position:absolute;left:540;top:105;width:0;height:0}
			#none {position:absolute;left:550;top:145;width:0;height:0}
			#bone {position:absolute;left:550;top:185;width:0;height:0}
			#lung {position:absolute;left:550;top:225;width:0;height:0}
			#hida {position:absolute;left:550;top:265;width:0;height:0}
			#heart {position:absolute;left:550;top:305;width:0;height:0}
			#renal {position:absolute;left:550;top:345;width:0;height:0}
			#liver {position:absolute;left:550;top:385;width:0;height:0}
			#brain {position:absolute;left:550;top:425;width:0;height:0}
			#lymph {position:absolute;left:550;top:465;width:0;height:0}
		</style>
	