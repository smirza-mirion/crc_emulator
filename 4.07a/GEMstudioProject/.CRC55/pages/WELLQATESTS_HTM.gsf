
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_QC_TESTS);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(75).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(75).setValue(0),
														    Amulet:document.sfDetector.forceUpdate();
														    NAME=refreshShowDetector">
														    
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(76).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(76).setValue(0),
														    Amulet:document.btnDetector.reappear();
														    NAME=refreshShowDetectorButton">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.btnSystemTest.reappear(),
														     Amulet:document.btnMDATest.reappear(),
														     Amulet:document.btnChiSquareTest.reappear();
														     NAME=refreshShowSystemTest">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnSystemTestWell.reappear(),
														     Amulet:document.btnSystemTestProbe.reappear(),
														     Amulet:document.btnMDATestWell.reappear(),
														     Amulet:document.btnMDATestProbe.reappear(),
														     Amulet:document.btnChiTestWell.reappear(),
														     Amulet:document.btnChiTestProbe.reappear();
														     NAME=refreshShowSystemTestDrilledProbe">
														     
