
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_THYROID_UPTAKE_ENTER_ADMIN);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfPatientIDLabel.reappear(),
														     Amulet:document.sfPatientIDText.forceUpdate(),
														     Amulet:document.sfPatientIDText.reappear(),
														     Amulet:document.sfPatientNameLabel.reappear(),
														     Amulet:document.sfPatientNameText.forceUpdate(),
														     Amulet:document.sfPatientNameText.reappear(),
														     Amulet:document.sfTime.reappear(),
														     Amulet:document.btnTime.forceUpdate(),
														     Amulet:document.btnTime.reappear(),
														     Amulet:document.btnAccept.reappear(),
														     Amulet:document.btnCancel.reappear();
														     NAME=refreshShowAll">
		<style type="text/css">
			#topbar {position:absolute;left:0;top:0;height:0;width:0}
			#bottombar {position:absolute;left:0;top:537;height:0;width:0}
			#title {position:absolute;left:5;top:0;width:0;height:0}
			
			#patientIDlabel {position:absolute;left:0;top:70;width:0;height:0}
			#patientIDtext {position:absolute;left:100;top:70;width:0;height:0}
			
			#patientlabel {position:absolute;left:0;top:100;width:0;height:0}
			#patienttext {position:absolute;left:100;top:100;width:0;height:0}
			
			#timelabel {position:absolute;left:0;top:260;width:0;height:0}
			#timetext {position:absolute;left:400;top:260;width:0;height:0}
			#accept {position:absolute;left:490;top:542;width:0;height:0}
			#cancel {position:absolute;left:645;top:542;width:0;height:0}
		</style>
	