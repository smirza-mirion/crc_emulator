
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_SETUP_BIOASSAY_ENTER_ROI);NAME=refreshInit">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTitle.reappear(),
														     Amulet:document.sfI131.reappear(),
														     Amulet:document.btnI131Start.forceUpdate(),
														     Amulet:document.btnI131Start.reappear(),
														     Amulet:document.btnI131End.forceUpdate(),
														     Amulet:document.btnI131End.reappear(),
														     Amulet:document.sfI125.reappear(),
														     Amulet:document.btnI125Start.forceUpdate(),
														     Amulet:document.btnI125Start.reappear(),
														     Amulet:document.btnI125End.forceUpdate(),
														     Amulet:document.btnI125End.reappear(),
														     Amulet:document.sfI123.reappear(),
														     Amulet:document.btnI123Start.forceUpdate(),
														     Amulet:document.btnI123Start.reappear(),
														     Amulet:document.btnI123End.forceUpdate(),
														     Amulet:document.btnI123End.reappear(),
														     Amulet:document.btnDefault.reappear(),
														     Amulet:document.btnAccept.reappear(),
														     Amulet:document.btnCancel.reappear();
														     Name=refreshShowAll">
														     
		<style type="text/css">
			#topbar {position:absolute;left:0;top:0;height:0;width:0}
			#bottombar {position:absolute;left:0;top:537;height:0;width:0}
			#title {position:absolute;left:5;top:0;width:0;height:0}
			
			#I131_label {position:absolute;left:0;top:100;width:0;height:0}
			#I131_start {position:absolute;left:195;top:100;width:0;height:0}
			#I131_end {position:absolute;left:415;top:100;width:0;height:0}
			
			#I125_label {position:absolute;left:0;top:200;width:0;height:0}
			#I125_start {position:absolute;left:195;top:200;width:0;height:0}
			#I125_end {position:absolute;left:415;top:200;width:0;height:0}
			
			#I123_label {position:absolute;left:0;top:300;width:0;height:0}
			#I123_start {position:absolute;left:195;top:300;width:0;height:0}
			#I123_end {position:absolute;left:415;top:300;width:0;height:0}
			
			#default {position:absolute;left:10;top:542;width:0;height:0}
			#accept {position:absolute;left:490;top:542;width:0;height:0}
			#cancel {position:absolute;left:645;top:542;width:0;height:0}
