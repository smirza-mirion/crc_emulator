
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_SETUP_COMMUNICATIONS);NAME=refreshInit">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
		                                                                                                     Amulet:document.HotKey.forceUpdate(),
														     Amulet:document.radioRHotKey.reappear(),
														     Amulet:document.radioPHotKey.reappear();
														     Name=refreshShowRadio">
		
