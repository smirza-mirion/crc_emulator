
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0, 0.01; URL=%SetScreen(%%SCREEN_KEYPAD); NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
		                                       								     Amulet:document.sfTitle.forceUpdate(),
														     Amulet:document.sfDisplay.forceUpdate(),
														     Amulet:document.btnBackSP.forceUpdate(),
														     Amulet:document.btnAccept.forceUpdate(),
														     Amulet:document.btnCancel.forceUpdate();
														     NAME=refreshShowKeypad">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnDiv.setX(Amulet:internalRAM.word(101).value()),
														     Amulet:document.btnDiv.setY(Amulet:internalRAM.word(102).value()),
		                                                                             			     Amulet:document.btnDiv.reappear();
														     NAME=refreshShowDiv">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														     Amulet:document.btnMult.setX(Amulet:internalRAM.word(103).value()),
														     Amulet:document.btnMult.setY(Amulet:internalRAM.word(104).value()),
														     Amulet:document.btnMult.reappear();
														     NAME=refreshShowMult">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(103).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(103).setValue(0),
														     Amulet:document.btnSub.setX(Amulet:internalRAM.word(105).value()),
														     Amulet:document.btnSub.setY(Amulet:internalRAM.word(106).value()),
														     Amulet:document.btnSub.reappear();
														     NAME=refreshShowSub">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(104).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(104).setValue(0),
														     Amulet:document.btnAdd.setX(Amulet:internalRAM.word(107).value()),
														     Amulet:document.btnAdd.setY(Amulet:internalRAM.word(108).value()),
														     Amulet:document.btnAdd.reappear();
														     NAME=refreshShowAdd">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(105).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(105).setValue(0),
														     Amulet:document.btnPeriod.setX(Amulet:internalRAM.word(109).value()),
														     Amulet:document.btnPeriod.setY(Amulet:internalRAM.word(110).value()),
														     Amulet:document.btnPeriod.reappear();
														     NAME=refreshShowPeriod">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(106).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(106).setValue(0),
		                            									     Amulet:document.sfDisplay.forceUpdate();
														     NAME=refreshUpdateDisplay">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(107).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(107).setValue(0),
														     Amulet:document.btnPlusMinus.reappear();
														     NAME=refreshShowPlusMinus">

		<style type="text/css">
			#background {position:absolute;left:0;top:0;height:600;width:800}
			#backgnd {position:absolute;left:0;top:0;height:0;width:0}
			#title {position:absolute;left:5;top:0;width:0;height:0}
			
			#plusminus {position:absolute;left:162;top:138;width:0;height:0}
			#display {position:absolute;left:238;top:138;width:0;height:0}
			#backsp {position:absolute;left:516;top:138;width:0;height:0}
			
			#7 {position:absolute;left:288;top:192;width:0;height:0}
			#8 {position:absolute;left:364;top:192;width:0;height:0}
			#9 {position:absolute;left:440;top:192;width:0;height:0}
			
			#4 {position:absolute;left:288;top:268;width:0;height:0}
			#5 {position:absolute;left:364;top:268;width:0;height:0}
			#6 {position:absolute;left:440;top:268;width:0;height:0}
			
			#1 {position:absolute;left:288;top:344;width:0;height:0}
			#2 {position:absolute;left:364;top:344;width:0;height:0}
			#3 {position:absolute;left:440;top:344;width:0;height:0}
			
			#0 {position:absolute;left:288;top:420;width:0;height:0}
			
			#div {position:absolute;left:0;top:90;width:0;height:0}
			#mult {position:absolute;left:76;top:90;width:0;height:0}
			#sub {position:absolute;left:152;top:90;width:0;height:0}
			#add {position:absolute;left:228;top:90;width:0;height:0}
			#period{position:absolute;left:0;top:394;width:0;height:0}
			
			#accept {position:absolute;left:483;top:533;width:0;height:0}
			#cancel {position:absolute;left:641;top:533;width:0;height:0}
		</style>
	