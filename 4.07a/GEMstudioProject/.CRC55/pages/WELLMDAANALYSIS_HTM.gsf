			#datetext {position:absolute;left:10;top:100;width:0;height:0}
			
			#detectorlabel {position:absolute;left:1;top:160;width:0;height:0}
			#detectortext {position:absolute;left:110;top:160;width:0;height:0}
			
			#nuclidelabel {position:absolute;left:1;top:200;width:0;height:0}
			#nuclidetext {position:absolute;left:110;top:200;width:0;height:0}
			#efficiencylabel {position:absolute;left:190;top:200;width:0;height:0}
			#efficiencytext {position:absolute;left:340;top:200;width:0;height:0}
			#roilabel {position:absolute;left:480;top:200;width:0;height:0}
			#roitext {position:absolute;left:550;top:200;width:0;height:0}
			
			#countslabel{position:absolute;left:10;top:240;width:0;height:0}
			#countstext {position:absolute;left:110;top:240;width:0;height:0}
			#counttimelabel {position:absolute;left:210;top:240;width:0;height:0}
			#counttimetext {position:absolute;left:360;top:240;width:0;height:0}
			
			#precislabel {position:absolute;left:10;top:280;width:0;height:0}
			#precistext {position:absolute;left:210;top:280;width:0;height:0}
			#correctlabel {position:absolute;left:310;top:280;width:0;height:0}
			#correcttext {position:absolute;left:510;top:280;width:0;height:0}
			
			#mdalabel {position:absolute;left:10;top:340;width:0;height:0}
			#mdatext {position:absolute;left:410;top:340;width:0;height:0}
			
			#back {position:absolute;left:693;top:13;width:0;height:0}
