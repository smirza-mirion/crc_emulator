
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_ERROR_MSG_LARGE);NAME=refreshInit">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTitle.forceUpdate(),
														     Amulet:document.sfLine1.forceUpdate(),
														     Amulet:document.sfLine2.forceUpdate(),
														     Amulet:document.sfLine3.forceUpdate(),
														     Amulet:document.sfLine4.forceUpdate(),
														     Amulet:document.sfLine5.forceUpdate(),
														     Amulet:document.sfLine6.forceUpdate(),
														     Amulet:document.sfLine7.forceUpdate(),
														     Amulet:document.sfLine8.forceUpdate(),
														     Amulet:document.sfLine9.forceUpdate(),
														     Amulet:document.sfLine10.forceUpdate(),
														     Amulet:document.sfLine11.forceUpdate(),
														     Amulet:document.sfLine12.forceUpdate(),
														     Amulet:document.sfLine13.forceUpdate(),
														     Amulet:document.sfLine14.forceUpdate(),
														     Amulet:document.btnOK.forceUpdate(),
														     Amulet:document.btnOK.reappear();
														     NAME=refreshShowError">
														     
