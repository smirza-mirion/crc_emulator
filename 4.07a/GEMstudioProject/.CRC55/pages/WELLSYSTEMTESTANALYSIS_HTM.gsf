
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_SYS_TEST_RESULT);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(91).value();TRIGGER=0xFF;URL=Amulet:document.btnInactivate.reappear();
														   NAME=refreshShowInactivate">
														   
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(91).value();TRIGGER=0xFF;URL=Amulet:document.btnInactivate.disappear();
														   NAME=refreshHideInactivate">
														   
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0xFF;URL=Amulet:document.btnHome.reappear();
														   NAME=refreshShowHome">
														   
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0xFF;URL=Amulet:document.btnHome.disappear();
														   NAME=refreshHideHome">
														   
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfDate.forceUpdate(),
														     Amulet:document.sfDetector.forceUpdate(),
														     Amulet:document.btnBackground.forceUpdate(),
														     Amulet:document.btnBackground.reappear(),
														     Amulet:document.sfSN.forceUpdate(),
														     Amulet:document.sfCalibratedOn.forceUpdate(),
														     Amulet:document.sfCalibratedActivity.forceUpdate(),
														     Amulet:document.sfCalculatedActivity.forceUpdate(),
														     Amulet:document.sfCountTime.forceUpdate(),
														     Amulet:document.sfMeasuredActivity.forceUpdate(),
														     Amulet:document.sfActivityDeviation.forceUpdate(),
														     Amulet:document.btnBack.reappear(),
														     Amulet:document.btnGraph.reappear();
														     NAME=refreshShow">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrint">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														     Amulet:document.sfHigh.reappear();
														     NAME=refreshShowHigh">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(103).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(103).setValue(0),
														     Amulet:internalRAM.byte(91).setValue(0xFF),
														     Amulet:document.btnInactivate.reappear();
														     NAME=refreshShowInactivate">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(104).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(104).setValue(0),
														     Amulet:document.sfInactivate.forceUpdate(),
														     Amulet:document.sfInactivate.reappear();
														     NAME=refreshShowInactivateString">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(105).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(105).setValue(0),
														     Amulet:internalRAM.byte(92).setValue(0xFF),
														     Amulet:document.btnHome.reappear();
														     NAME=refreshShowHomeButton">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(106).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(106).setValue(0),
														     Amulet:document.refreshShowHome.forceUpdate(),
														     Amulet:document.btnBack.reappear(),
														     Amulet:document.refreshShowInactivate.forceUpdate(),
														     Amulet:document.btnGraph.reappear(),
														     Amulet:document.btnBackground.reappear(),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrintAndHidden">
		
		<style type="text/css">
			#topbar {position:absolute;left:0;top:0;height:0;width:0}
