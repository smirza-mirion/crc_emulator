			#measuredactivitylabel {position:absolute;left:0;top:410;width:0;height:0}
			#measuredactivitytext {position:absolute;left:300;top:410;width:0;height:0}
			
			#devlabel {position:absolute;left:0;top:450;width:0;height:0}
			#devtext {position:absolute;left:300;top:450;width:0;height:0}
			#devhigh {position:absolute;left:450;top:450;width:0;height:0}
			
			#home {position:absolute;left:8;top:13;width:0;height:0}
			#back {position:absolute;left:693;top:13;width:0;height:0}
			#print {position:absolute;left:536;top:543;width:0;height:0}
			#graph {position:absolute;left:642;top:543;width:0;height:0}
