														     Amulet:document.btn125.forceUpdate(),
														     Amulet:document.btn125.reappear(),
														     Amulet:document.btn123.forceUpdate(),
														     Amulet:document.btn123.reappear(),
														     Amulet:document.btnSetupBioAssayROI.reappear(),
														     Amulet:document.btnAccept.reappear(),
														     Amulet:document.btnCancel.reappear(),
														     Amulet:document.line1.reappear(),
														     Amulet:document.line2.reappear(),
														     Amulet:document.sfI131_2.reappear(),
														     Amulet:document.sfI125_2.reappear(),
														     Amulet:document.sfI123_2.reappear(),
														     Amulet:document.sfEfficiencyLabel.reappear(),
														     Amulet:document.sf131Efficiency.forceUpdate(),
														     Amulet:document.sf131Efficiency.reappear(),
