														     Amulet:document.sf123125Label.forceUpdate(),
														     Amulet:document.sf123125Label.reappear(),
														     Amulet:document.btnEnterEfficiency.reappear();
														     Name=refreshShowAll">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnMeasureEfficiency.reappear();
														     Name=refreshShowMeasure">
		
