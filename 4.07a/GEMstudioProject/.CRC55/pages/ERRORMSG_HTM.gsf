
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		<META NAME="Amulet" CONTENT="GrayLCD.Page">
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_ERROR_MSG);NAME=refreshInit">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														      Amulet:document.sfTitle.forceUpdate(),
														      Amulet:document.sfMessage.forceUpdate(),
														      Amulet:document.btnOK.forceUpdate(),
														      Amulet:document.btnOK.reappear();
														      NAME=refreshShowError">
														      
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.sfTitle.forceUpdate(),
														     Amulet:document.sfMessage.forceUpdate();
														     NAME=refreshShowErrorOnly">
														     
		<style type="text/css">
			#backgnd {position:absolute;left:190;top:90;width:0;height:0}
			#title {position:absolute;left:243;top:175;width:0;height:0}
			#message {position:absolute;left:220;top:218;width:0;height:0}
			#button {position:absolute;left:300;top:395;width:0;height:0}
		</style>
	