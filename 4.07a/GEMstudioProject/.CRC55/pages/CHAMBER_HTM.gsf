
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page">
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_SELECT_CHAMBER);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTitle.reappear(),
														     Amulet:document.sfTitle.forceUpdate(),
														     Amulet:document.btn1.reappear(),
														     Amulet:document.btn1.forceUpdate(),
														     Amulet:document.btn2.reappear(),
														     Amulet:document.btn2.forceUpdate(),
														     Amulet:document.btnCancel.reappear(),
														     Amulet:document.btnCancel.forceUpdate();
														     NAME=refreshShowNotification">
		
		<style type="text/css">
			#background {position:absolute;left:0;top:0;height:600;width:800}
			#title {position:absolute;left:5;top:0;height:0;width:0}
			#b1 {position:absolute;left:200;top:180;width:0;height:0}
			#b2 {position:absolute;left:200;top:350;width:0;height:0}
			#cancel {position:absolute;left:641;top:533;width:0;height:0}
		</style>
	