
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_SETUP_TEST_SOURCE);NAME=refreshInit">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfSN.forceUpdate(),
														     Amulet:document.sfCalibratedOn.forceUpdate(),
														     Amulet:document.sfCalibratedActivity.forceUpdate();
														     NAME=refreshShow">

