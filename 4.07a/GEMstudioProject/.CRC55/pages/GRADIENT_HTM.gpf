<?xml version="1.0" encoding="UTF-8"?>
<PAGE NAME="GRADIENT_HTM">
  <PROPERTIES>
    <HEAD>
      <FUNCTIONS SOURCE="GRADIENT_HTM.gsf"/>
      <PARENT_PAGE NAME=""/>
      <GS_DRAW>True</GS_DRAW>
      <BGCOLOR>#FFFFFF</BGCOLOR>
      <TRANSITIONS>Clear Screen With Background Color</TRANSITIONS>
    </HEAD>
  </PROPERTIES>
  <BKGND/>
  <BODY>
    <Image>
      <Name Type="12">Image_66</Name>
      <MidX Type="13">160</MidX>
      <MidY Type="13">120</MidY>
      <Width Type="13">326</Width>
      <Height Type="13">246</Height>
      <cacheImage Type="2" Editable="True">True	True	False</cacheImage>
      <invisible Type="2" Editable="True">False	True	False</invisible>
      <file Type="16" Editable="True">./Images/Gradient.png</file>
    </Image>
    <CustomButton>
      <Name Type="12">btnBack</Name>
      <MidX Type="13">743</MidX>
      <MidY Type="13">38</MidY>
      <Width Type="13">106</Width>
      <Height Type="13">56</Height>
      <cacheImage Type="2" Editable="True">True	True	False</cacheImage>
      <invisible Type="2" Editable="True">False	True	False</invisible>
      <downImage Type="16" Editable="True">./Images/back_big.png</downImage>
      <upImage Type="16" Editable="True">./Images/back_big.png</upImage>
      <href Type="15" Editable="True">MyUART.byte(0).setValue(4)</href>
      <label Type="12" Editable="True"/>
      <onButtonPress Type="10" Editable="True">GRAY	Depress	Gray</onButtonPress>
      <repeatRate Type="20" Editable="True">0.00</repeatRate>
    </CustomButton>
  </BODY>
</PAGE>
