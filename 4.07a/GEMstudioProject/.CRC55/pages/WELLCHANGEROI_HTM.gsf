
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		

		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_CHANGE_ROI);NAME=refreshInit">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfNuclide.forceUpdate(),
														     Amulet:document.sfStartROI.forceUpdate(),
														     Amulet:document.sfEndROI.forceUpdate();
														     NAME=refreshShowDisplay">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.line1black.reappear(),
														     Amulet:document.line1black.forceUpdate(),
														     Amulet:document.line2black.reappear(),
														     Amulet:document.line2black.forceUpdate(),
														     Amulet:document.line3black.reappear(),
														     Amulet:document.line3black.forceUpdate();
														     NAME=refreshShowBlack">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														    Amulet:document.line1red.reappear(),
														    Amulet:document.line1red.forceUpdate(),
														    Amulet:document.line2red.reappear(),
														    Amulet:document.line2red.forceUpdate(),
														    Amulet:document.line3red.reappear(),
														    Amulet:document.line3red.forceUpdate();
														    NAME=refreshShowRed">
		
