
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		<META NAME="Amulet" CONTENT="NoClearLCD.NotThisPage">
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0, 0.01; URL=%SetScreen(%%SCREEN_SLEEP);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(76).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(76).setValue(0),
														    lcdBacklight.setValue(internalRAM.byte(55));
														    NAME=refreshSleep">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(77).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(77).setValue(0),
														    lcdBacklight.setValue(internalRAM.byte(55)),
														    MyUART.word(0).setValue(0xAEAF);
														    NAME=refreshWake">
														    
