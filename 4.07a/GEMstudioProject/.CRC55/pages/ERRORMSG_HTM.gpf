      <MidX Type="13">400</MidX>
      <MidY Type="13">195</MidY>
      <Width Type="13">321</Width>
      <Height Type="13">46</Height>
      <invisible Type="2" Editable="True">False	True	False</invisible>
      <border Type="13" Editable="True">0</border>
      <fillColor Type="11" Editable="True">#00000000</fillColor>
      <font Type="14" Editable="True">Franklin Gothic Book, 18PT (local)</font>
      <fontColor Type="11" Editable="True">white</fontColor>
      <fontStyle Type="18" Editable="True">BOLD|UNDERLINE	Plain	Bold	Italic	Underline	Strike</fontStyle>
      <horizontalAlign Type="10" Editable="True">CENTER	Left	Center	Right</horizontalAlign>
      <href Type="24" Editable="True">Amulet:internalRAM.string(100).value()</href>
      <initialCondition Type="12" Editable="True"/>
      <printf Type="12" Editable="True">%.51s</printf>
      <verticalAlign Type="10" Editable="True">TOP	Top	Middle	Bottom</verticalAlign>
    </StringField>
    <StringField>
