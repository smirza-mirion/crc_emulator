      <MidX Type="13">400</MidX>
      <MidY Type="13">301</MidY>
      <Width Type="13">366</Width>
      <Height Type="13">172</Height>
      <invisible Type="2" Editable="True">False	True	False</invisible>
      <border Type="13" Editable="True">0</border>
      <fillColor Type="11" Editable="True">#00000000</fillColor>
