<?xml version="1.0" encoding="UTF-8"?>
<PAGE NAME="ERRORMSG_HTM">
  <PROPERTIES>
    <HEAD>
      <FUNCTIONS SOURCE="ERRORMSG_HTM.gsf"/>
      <PARENT_PAGE NAME=""/>
      <GS_DRAW>True</GS_DRAW>
