    </HEAD>
  </PROPERTIES>
  <BKGND/>
  <BODY>
    <Image>
      <Name Type="12">imgErrorBkg</Name>
      <MidX Type="13">400</MidX>
      <MidY Type="13">300</MidY>
      <Width Type="13">426</Width>
      <Height Type="13">426</Height>
      <cacheImage Type="2" Editable="True">True	True	False</cacheImage>
      <invisible Type="2" Editable="True">False	True	False</invisible>
      <file Type="16" Editable="True">./Images/error.png</file>
    </Image>
    <StringField>
