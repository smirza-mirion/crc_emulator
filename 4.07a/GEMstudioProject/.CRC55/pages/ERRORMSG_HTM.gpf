      <fontColor Type="11" Editable="True">red</fontColor>
      <fontStyle Type="18" Editable="True">BOLD	Plain	Bold	Italic	Underline	Strike</fontStyle>
      <horizontalAlign Type="10" Editable="True">CENTER	Left	Center	Right</horizontalAlign>
