
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0, 0.01; URL=%SetScreen(%%SCREEN_DELETE_ALL_INVENTORY); NAME=refreshInit">

	<META HTTP-EQUIV="REFRESH" CONTENT="0.0;URL=Amulet:document.refreshShowHomeEnglish.forceUpdate(),
						    Amulet:document.refreshShowHomeFrench.forceUpdate();
						    NAME=refreshShowHome">
	<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0x00;URL=Amulet:document.btnHome.reappear();
													     NAME=refreshShowHomeEnglish">
	<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0x01;URL=Amulet:document.btnHomeFrench.reappear();
													     NAME=refreshShowHomeFrench">
													     
	<META HTTP-EQUIV="REFRESH" CONTENT="0.0;URL=Amulet:document.refreshHideHomeEnglish.forceUpdate(),
						    Amulet:document.refreshHideHomeFrench.forceUpdate();
						    NAME=refreshHideHome">
	<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0x00;URL=Amulet:document.btnHome.disappear();
													     NAME=refreshHideHomeEnglish">
	<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0x01;URL=Amulet:document.btnHomeFrench.disappear();
													     NAME=refreshHideHomeFrench">
													     
	<META HTTP-EQUIV="REFRESH" CONTENT="0.0;URL=Amulet:document.refreshShowBackEnglish.forceUpdate(),
						    Amulet:document.refreshShowBackFrench.forceUpdate();
						    NAME=refreshShowBack">
	<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0x00;URL=Amulet:document.btnBack.reappear();
													     NAME=refreshShowBackEnglish">
	<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0x01;URL=Amulet:document.btnBackFrench.reappear();
													     NAME=refreshShowBackFrench">
													     
	<META HTTP-EQUIV="REFRESH" CONTENT="0.0;URL=Amulet:document.refreshHideBackEnglish.forceUpdate(),
						    Amulet:document.refreshHideBackFrench.forceUpdate();
						    NAME=refreshHideBack">
	<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0x00;URL=Amulet:document.btnBack.disappear();
													     NAME=refreshHideBackEnglish">
	<META HTTP-EQUIV="REFRESH" CONTENT="0.00;ONVAR=Amulet:internalRAM.byte(92).value();TRIGGER=0x01;URL=Amulet:document.btnBackFrench.disappear();
													     NAME=refreshHideBackFrench">



		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
													     	   Amulet:document.sfTitle.reappear(),
													         Amulet:document.sfTitle.forceUpdate(),
													     	   Amulet:document.sfQuestion.reappear(),
													         Amulet:document.sfQuestion.forceUpdate(),
													     	   Amulet:document.refreshShowHome.forceUpdate(),
													     	   Amulet:document.refreshShowBack.forceUpdate(),
														     Amulet:document.btnYes.reappear(),
														     Amulet:document.btnYes.forceUpdate(),
														     Amulet:document.btnNo.reappear(),
														     Amulet:document.btnNo.forceUpdate();
														     NAME=refreshShow">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     %Back;
														     NAME=refreshExit">
														     
		<style type="text/css">
			#backgnd {position:absolute;left:0;top:0;width:800;height:600}
			#top {position:absolute;left:0;top:0;width:0;height:0}
			#bottom {position:absolute;left:0;top:556;width:0;height:0}
			#topbar {position:absolute;left:0;top:0;height:0;width:0}
			#bottombar {position:absolute;left:0;top:537;height:0;width:0}
			#title {position:absolute;left:130;top:0;width:0;height:0}
			
			#question {position:absolute;left:20;top:100;width:0;height:0}
			#yes {position:absolute;left:480;top:100;width:0;height:0}
			#no {position:absolute;left:650;top:100;width:0;height:0}
			
			#home {position:absolute;left:8;top:13;width:0;height:0}
			#back {position:absolute;left:693;top:13;width:0;height:0}
		</style>
	