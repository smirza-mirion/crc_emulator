
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0, 0.01; URL=%SetScreen(%%SCREEN_MEASURE); NAME=refreshInit">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTitle.forceUpdate(),
														     Amulet:document.btnAccept.forceUpdate(),
														     Amulet:document.btnAccept.reappear(),
														     Amulet:document.btnCancel.forceUpdate(),
														     Amulet:document.btnCancel.reappear();
														     Name=refreshDisplayMeasure">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.sfNuclide.forceUpdate(),
		                                                                                                     Amulet:document.sfDisplay.forceUpdate();
														     NAME=refreshShowDisplay">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														     Amulet:document.sfMessageWhite.forceUpdate();
														     NAME=refreshShowWhite">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(103).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(103).setValue(0),
														     Amulet:document.sfMessageRed.forceUpdate();
														     NAME=refreshShowRed">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(104).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(104).setValue(0),
														     Amulet:document.sfMessageRed.disappear(),
														     Amulet:document.sfMessageWhite.reappear(),
														     Amulet:document.sfMessageWhite.forceUpdate();
														     Name=refreshReappearWhite">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(105).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(105).setValue(0),
														     Amulet:document.sfMessageWhite.disappear(),
														     Amulet:document.sfMessageRed.reappear(),
														     Amulet:document.sfMessageRed.forceUpdate();
														     Name=refreshReappearRed">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(106).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(106).setValue(0),
														     Amulet:document.sfTitle.forceUpdate(),
														     Amulet:document.btnCancel.forceUpdate(),
														     Amulet:document.btnCancel.reappear();
														     Name=refreshDisplayCancel">

		<style type="text/css">
			#background {position:absolute;left:0;top:0;width:800;height:600}
			#title {position:absolute;left:5;top:0;width:0;height:0}
			#nuclide {position:absolute;left:0;top:125;width:0;height:0}
			#display {position:absolute;left:10;top:225;width:0;height:0}
			#message {position:absolute;left:0;top:375;width:0;height:0}
			#accept {position:absolute;left:483;top:533;width:0;height:0}
			#cancel {position:absolute;left:641;top:533;width:0;height:0}
		</style>
	