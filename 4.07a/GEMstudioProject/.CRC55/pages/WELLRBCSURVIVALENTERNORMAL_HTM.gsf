
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_RBC_SURVIVAL_ENTER_NORMAL);NAME=refreshInit">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTitle.reappear(),
														     Amulet:document.sfMin.reappear(),
														     Amulet:document.sfMax.reappear(),
														     Amulet:document.btnMin.forceUpdate(),
														     Amulet:document.btnMin.reappear(),
														     Amulet:document.btnMax.forceUpdate(),
														     Amulet:document.btnMax.reappear(),
														     Amulet:document.btnClear.reappear(),
														     Amulet:document.btnAccept.reappear(),
														     Amulet:document.btnCancel.reappear();
														     Name=refreshShowAll">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnMin.forceUpdate(),
														     Amulet:document.btnMin.reappear(),
														     Amulet:document.btnMax.forceUpdate(),
														     Amulet:document.btnMax.reappear(),
														     Amulet:document.btnClear.reappear();
														     NAME=refreshShowRow">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														     Amulet:document.sfTitleView.reappear(),
														     Amulet:document.btnBack.reappear(),
														     Amulet:document.sfMin.reappear(),
														     Amulet:document.sfMax.reappear(),
														     Amulet:document.sfMinValue.forceUpdate(),
														     Amulet:document.sfMinValue.reappear(),
														     Amulet:document.sfMaxValue.forceUpdate(),
														     Amulet:document.sfMaxValue.reappear();
														     Name=refreshShowView">
														     
		<style type="text/css">
			#topbar {position:absolute;left:0;top:0;height:0;width:0}
			#bottombar {position:absolute;left:0;top:537;height:0;width:0}
			#title {position:absolute;left:150;top:0;width:0;height:0}
			#back {position:absolute;left:693;top:13;width:0;height:0}
			
			#min_label {position:absolute;left:230;top:100;width:0;height:0}
			#max_label {position:absolute;left:440;top:100;width:0;height:0}
			
			#min {position:absolute;left:230;top:150;width:0;height:0}
			#max {position:absolute;left:440;top:150;width:0;height:0}
			#clear {position:absolute;left:650;top:150;width:0;height:0}
			
			#accept {position:absolute;left:490;top:542;width:0;height:0}
			#cancel {position:absolute;left:645;top:542;width:0;height:0}
		</style>
	