
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_DELETE_LINEATOR);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
													     	   Amulet:document.sfTitle.reappear(),
													         Amulet:document.sfTitle.forceUpdate(),
													     	   Amulet:document.sfDelete.reappear(),
													         Amulet:document.sfDelete.forceUpdate(),
														     Amulet:document.btnYes.reappear(),
														     Amulet:document.btnYes.forceUpdate(),
														     Amulet:document.btnNo.reappear(),
														     Amulet:document.btnNo.forceUpdate();
														     NAME=refreshShow">
		
