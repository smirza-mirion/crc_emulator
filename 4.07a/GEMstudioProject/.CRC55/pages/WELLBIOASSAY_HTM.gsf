
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_BIOASSAY);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(80).value();TRIGGER=0xFF;URL=Amulet:document.btnStaffText.forceUpdate(),
														   Amulet:document.btnStaffText.reappear();
														   NAME=refreshShowStaffButton">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(81).value();TRIGGER=0xFF;URL=Amulet:document.sfStaffText.forceUpdate(),
														   Amulet:document.sfStaffText.reappear();
														   NAME=refreshShowStaffText">
														   
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(82).value();TRIGGER=0xFF;URL=Amulet:document.btnNext.reappear();
														   NAME=refreshShowNextButton">
														   
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTitle.reappear(),
														     Amulet:document.sfStaffLabel.reappear(),
														     Amulet:document.refreshShowStaffButton.forceUpdate(),
														     Amulet:document.refreshShowStaffText.forceUpdate(),
														     Amulet:document.sfDistanceLabel.reappear(),
														     Amulet:document.btnDistanceText.forceUpdate(),
														     Amulet:document.btnDistanceText.reappear(),
														     Amulet:document.sfBackground.reappear(),
														     Amulet:document.btnBackground.forceUpdate(),
														     Amulet:document.btnBackground.reappear(),
														     Amulet:document.sfNeck.reappear(),
														     Amulet:document.btnNeck.forceUpdate(),
														     Amulet:document.btnNeck.reappear(),
														     Amulet:document.refreshShowNextButton.forceUpdate(),
														     Amulet:document.btnExit.reappear();
														     NAME=refreshShowAll">
		
