
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_SETUP_PASSWORD);NAME=refreshInit">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTitle.reappear(),
														     Amulet:document.sfTitle.forceUpdate(),
														     Amulet:document.sfCurrentLabel.forceUpdate(),
														     Amulet:document.sfCurrent.forceUpdate(),
														     Amulet:document.sfNewLabel.forceUpdate(),
														     Amulet:document.sfNew.forceUpdate(),
														     Amulet:document.sfConfirmLabel.forceUpdate(),
														     Amulet:document.sfConfirm.forceUpdate(),
														     Amulet:document.sfError.forceUpdate(),
														     Amulet:document.btnDefault.forceUpdate(),
														     Amulet:document.btnAccept.forceUpdate(),
														     Amulet:document.btnCancel.forceUpdate();
														     NAME=refreshDisplayPassword">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnDefault.reappear(),
														     Amulet:document.btnDefault.forceUpdate(),
														     Amulet:document.btnAccept.reappear(),
														     Amulet:document.btnAccept.forceUpdate(),
														     Amulet:document.btnCancel.reappear(),
														     Amulet:document.btnCancel.forceUpdate(),
														     Amulet:document.sfError.reappear(),
														     Amulet:document.sfError.forceUpdate();
														     NAME=refreshDisplayError">
														     
		<style type="text/css">
			#topbar {position:absolute;left:0;top:0;height:0;width:0}
			#bottombar {position:absolute;left:0;top:537;height:0;width:0}
			#title {position:absolute;left:130;top:0;width:0;height:0}
			#currentlabel {position:absolute;left:10;top:150;width:0;height:0}
			#current {position:absolute;left:300;top:150;width:0;height:0}
			#newlabel {position:absolute;left:10;top:225;width:0;height:0}
			#new {position:absolute;left:300;top:225;width:0;height:0}
			#confirmlabel {position:absolute;left:10;top:300;width:0;height:0}
			#confirm {position:absolute;left:300;top:300;width:0;height:0}
			#error {position:absolute;left:100;top:400;width:0;height:0}
			#default {position:absolute;left:10;top:487;width:0;height:0}
			#accept {position:absolute;left:490;top:542;width:0;height:0}
			#cancel {position:absolute;left:645;top:542;width:0;height:0}
		</style>
	