                                                        EQ=0;THEN=Amulet:internalRAM.byte(101).setValue(3);
                                                        NAME=refreshDecDayTen">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;IF=Amulet:internalRAM.byte(102).value();
                                                        LT=9;THEN=Amulet:internalRAM.byte(102).inc();
                                                        EQ=9;THEN=Amulet:internalRAM.byte(102).setValue(0);
                                                        GT=9;THEN=Amulet:internalRAM.byte(102).setValue(0);
                                                        NAME=refreshIncDayOne">
