		<!--META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.word(100).value();TRIGGER.LT=2030;URL=Amulet:internalRAM.word(100).inc();NAME=refreshIncYear">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.word(100).value();TRIGGER.NEQ=1970;URL=Amulet:internalRAM.word(100).dec();NAME=refreshDecYear"-->
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.word(100).value();TRIGGER.LT=Amulet:internalRAM.word(99).value();URL=Amulet:internalRAM.word(100).inc();NAME=refreshIncYear">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.word(100).value();TRIGGER.LT=Amulet:internalRAM.word(97).value();URL=Amulet:internalRAM.word(100).add(10);NAME=refreshIncYear10">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.word(100).value();TRIGGER.NEQ=Amulet:internalRAM.word(98).value();URL=Amulet:internalRAM.word(100).dec();NAME=refreshDecYear">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.word(100).value();TRIGGER.GT=Amulet:internalRAM.word(96).value();URL=Amulet:internalRAM.word(100).sub(10);NAME=refreshDecYear10">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;IF=Amulet:internalRAM.byte(100).value();
                                                        LT=12;THEN=Amulet:internalRAM.byte(100).inc();
                                                        EQ=12;THEN=Amulet:internalRAM.byte(100).setValue(1);
                                                        GT=12;THEN=Amulet:internalRAM.byte(100).setValue(1);
                                                        NAME=refreshIncMonth">
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;IF=Amulet:internalRAM.byte(100).value();
                                                        GT=1;THEN=Amulet:internalRAM.byte(100).dec();
                                                        EQ=1;THEN=Amulet:internalRAM.byte(100).setValue(12);
                                                        LT=1;THEN=Amulet:internalRAM.byte(100).setValue(12);
                                                        NAME=refreshDecMonth">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;IF=Amulet:internalRAM.byte(101).value();
                                                        LT=3;THEN=Amulet:internalRAM.byte(101).inc();
                                                        EQ=3;THEN=Amulet:internalRAM.byte(101).setValue(0);
                                                        GT=3;THEN=Amulet:internalRAM.byte(101).setValue(0);
