		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;IF=Amulet:internalRAM.byte(104).value();
                                                        LT=9;THEN=Amulet:internalRAM.byte(104).inc();
                                                        EQ=9;THEN=Amulet:internalRAM.byte(104).setValue(0);
