
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_SCHILLING_REPORT);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(91).value();TRIGGER=0xFF;URL=Amulet:document.btnInactivate.reappear();
														   NAME=refreshShowInactivate">
														   
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(91).value();TRIGGER=0xFF;URL=Amulet:document.btnInactivate.disappear();
														   NAME=refreshHideInactivate">
														   
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfTestTime.forceUpdate(),
														     Amulet:document.sfDOB.forceUpdate(),
														     Amulet:document.sfTestID.forceUpdate(),
														     Amulet:document.sfPatientID.forceUpdate(),
														     Amulet:document.sfFirstName.forceUpdate(),
														     Amulet:document.sfLastName.forceUpdate(),
														     Amulet:document.sfSex.forceUpdate(),
														     Amulet:document.sfPhysician.forceUpdate(),
														     Amulet:document.sfTechID.forceUpdate(),
														     Amulet:document.btnBackgroundActivity.forceUpdate(),
														     Amulet:document.btnBackgroundActivity.reappear(),
														     Amulet:document.btnStandardActivity.forceUpdate(),
														     Amulet:document.btnStandardActivity.reappear(),
														     Amulet:document.btnAliquotActivity.forceUpdate(),
														     Amulet:document.btnAliquotActivity.reappear(),
														     Amulet:document.sfDilutionFactor.forceUpdate(),
														     Amulet:document.sfUrineVolume.forceUpdate(),
														     Amulet:document.sfAliquotVolume.forceUpdate(),
														     Amulet:document.sfExcretion.forceUpdate();
														     NAME=refreshShowDisplay">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrint">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														     Amulet:internalRAM.byte(91).setValue(0xFF),
														     Amulet:document.btnInactivate.reappear();
														     NAME=refreshShowInactivate">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(103).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(103).setValue(0),
														     Amulet:document.sfInactivate.forceUpdate(),
														     Amulet:document.sfInactivate.reappear();
														     NAME=refreshShowInactivateString">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(104).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(104).setValue(0),
														     Amulet:document.btnBack.reappear(),
														     Amulet:document.refreshShowInactivate.forceUpdate(),
														     Amulet:document.btnBackgroundActivity.reappear(),
														     Amulet:document.btnStandardActivity.reappear(),
														     Amulet:document.btnAliquotActivity.reappear(),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrintAndHidden">
