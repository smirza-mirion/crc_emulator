
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_LOW_LEVEL);NAME=refreshInit">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfMode.reappear(),
														     Amulet:document.sfMode.forceUpdate();
														     NAME=refreshShowMode">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnClear.reappear();
														     NAME=refreshShowClearButton">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														     Amulet:document.sfMemStatus.forceUpdate();
														     NAME=refreshShowMemStatus">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(103).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(103).setValue(0),
														     Amulet:document.btnMemTestOn.disappear(),
														     Amulet:document.btnOff.disappear(),
														     Amulet:document.btnChamber.disappear(),
														     Amulet:document.btnWell.disappear(),
														     Amulet:document.btnClear.disappear(),
														     Amulet:document.btnAccept.disappear(),
														     Amulet:document.btnCancel.disappear(),
														     Amulet:document.sfMode.disappear(),
														     Amulet:document.btnMemTestOff.reappear();
														     NAME=refreshShowMemOff">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(104).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(104).setValue(0),
														     Amulet:document.btnMemTestOff.disappear(),
														     Amulet:document.btnMemTestOn.reappear(),
														     Amulet:document.btnOff.reappear(),
														     Amulet:document.btnChamber.reappear(),
														     Amulet:document.btnWell.reappear(),
														     Amulet:document.btnClear.reappear(),
														     Amulet:document.btnAccept.reappear(),
														     Amulet:document.btnCancel.reappear(),
														     Amulet:document.sfMode.reappear();
														     NAME=refreshShowMemOn">
														     
		<style type="text/css">
			#topbar {position:absolute;left:0;top:0;height:0;width:0}
			#bottombar {position:absolute;left:0;top:537;height:0;width:0}
			#title {position:absolute;left:5;top:0;width:0;height:0}
			#home {position:absolute;left:8;top:13;width:0;height:0}
			#back {position:absolute;left:693;top:13;width:0;height:0}
			
			#mode {position:absolute;left:200;top:80;width:0;height:0}
			#off {position:absolute;left:67;top:155;width:0;height:0}
			#chamber {position:absolute;left:67;top:255;width:0;height:0}
			#well {position:absolute;left:67;top:355;width:0;height:0}
			#clear {position:absolute;left:67;top:455;width:0;height:0}
			
			#mem_text {position:absolute;left:434;top:155;width:0;height:0}
			#mem_test_on {position:absolute;left:434;top:255;width:0;height:0}
			#mem_test_off {position:absolute;left:434;top:355;width:0;height:0}
			
			#accept {position:absolute;left:490;top:542;width:0;height:0}
			#cancel {position:absolute;left:645;top:542;width:0;height:0}
		</style>
	