
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_MANUAL);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfGain1.reappear(),
														     Amulet:document.sfGain1.forceUpdate(),
														     Amulet:document.sfGain2.reappear(),
														     Amulet:document.sfGain2.forceUpdate(),
														     Amulet:document.sfOffset.reappear(),
														     Amulet:document.sfOffset.forceUpdate(),
														     Amulet:document.sfThreshold.reappear(),
														     Amulet:document.sfThreshold.forceUpdate(),
														     Amulet:document.sfHV.reappear(),
														     Amulet:document.sfHV.forceUpdate();
														     NAME=refreshDisplay">
														     
