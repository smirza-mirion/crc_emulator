
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_MEASURE_EFFICIENCY);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;ONVAR=Amulet:internalRAM.byte(90).value();TRIGGER=0xFF;URL=Amulet:document.btnPrint.reappear();
														   NAME=refreshShowPrint">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfDetector.forceUpdate(),
														     Amulet:document.sfNuclide.reappear(),
														     Amulet:document.sfNuclide.forceUpdate(),
														     Amulet:document.btnCalibratedOnCustom.forceUpdate(),
														     Amulet:document.btnCalibratedOnCustom.reappear(),
														     Amulet:document.btnCalibratedActivityCustom.forceUpdate(),
														     Amulet:document.btnCalibratedActivityCustom.reappear(),
														     Amulet:document.sfMeasureSource.reappear(),
														     Amulet:document.sfMeasureSource.forceUpdate(),
														     Amulet:document.sfAutocalibrate.reappear(),
														     Amulet:document.sfAutocalibrate.forceUpdate(),
														     Amulet:document.sfMeasureBackground.reappear(),
														     Amulet:document.sfMeasureBackground.forceUpdate(),
														     Amulet:document.sfStatus.reappear(),
														     Amulet:document.sfStatus.forceUpdate();
														     NAME=refreshDisplay">
														     												     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnMeasureSource.reappear();
														     NAME=refreshSource">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														     Amulet:document.btnSave.reappear(),
														     Amulet:document.refreshShowPrint.forceUpdate();
														     NAME=refreshSave">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(103).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(103).setValue(0),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrint">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(104).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(104).setValue(0),
														     Amulet:document.btnBack.reappear(),
														     Amulet:document.btnCalibratedOnCustom.reappear(),
														     Amulet:document.btnCalibratedActivityCustom.reappear(),
														     Amulet:document.btnMeasureSource.reappear(),
														     Amulet:document.btnAutocalibrate.reappear(),
														     Amulet:document.btnMeasureBackground.reappear(),
														     Amulet:document.btnSave.reappear(),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrintAndHidden">
														     
