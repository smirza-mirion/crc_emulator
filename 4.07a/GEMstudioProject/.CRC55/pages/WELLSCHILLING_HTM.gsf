
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_SCHILLING);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfDetector.forceUpdate(),
														     Amulet:document.sfBackgroundLabel.forceUpdate(),
														     Amulet:document.btnBackground.forceUpdate(),
														     Amulet:document.btnBackground.reappear(),
														     Amulet:document.btnUrine.forceUpdate(),
														     Amulet:document.btnUrine.reappear(),
														     Amulet:document.btnAliqotVol.forceUpdate(),
														     Amulet:document.btnAliqotVol.reappear(),
														     Amulet:document.btnDilution.forceUpdate(),
														     Amulet:document.btnDilution.reappear(),
														     Amulet:document.btnStandard.forceUpdate(),
														     Amulet:document.btnStandard.reappear(),
														     Amulet:document.btnAliqot.forceUpdate(),
														     Amulet:document.btnAliqot.reappear();
														     Name=refreshShow">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnCalculate.reappear();
														     NAME=refreshShowCalculate">
		
