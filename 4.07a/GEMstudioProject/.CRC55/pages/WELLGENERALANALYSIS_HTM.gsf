
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_GENERAL_ANALYSIS);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfMeasuredOn.forceUpdate(),
														     Amulet:document.sfCountTime.forceUpdate(),
														     Amulet:document.sfTotalCount.forceUpdate(),
														     Amulet:document.sfTotalBackground.forceUpdate(),
														     Amulet:document.sfTotalNet.forceUpdate(),
														     Amulet:document.sfRegionLabel.forceUpdate(),
														     Amulet:document.sfRegionText.forceUpdate(),
														     Amulet:document.sfEfficiencyLabel.forceUpdate(),
														     Amulet:document.sfEfficiency1Text.forceUpdate(),
														     Amulet:document.sfEfficiency2Text.forceUpdate(),
														     Amulet:document.sfROILabel.forceUpdate(),
														     Amulet:document.sfROIText.forceUpdate(),
														     Amulet:document.sfROIBackgroundLabel.forceUpdate(),
														     Amulet:document.sfROIBackgroundText.forceUpdate(),
														     Amulet:document.sfROINetLabel.forceUpdate(),
														     Amulet:document.sfROINetText.forceUpdate(),
														     Amulet:document.sfDPMLabel.forceUpdate(),
														     Amulet:document.sfDPMText1.forceUpdate(),
														     Amulet:document.sfDetector.forceUpdate(),
														     Amulet:document.sfDetectorExt.forceUpdate();
														     NAME=refreshShowDisplay">
														     
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(101).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(101).setValue(0),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrint">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(102).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(102).setValue(0),
														     Amulet:document.btnHome.reappear(),
														     Amulet:document.btnBack.reappear(),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrintAndHidden">
														     
