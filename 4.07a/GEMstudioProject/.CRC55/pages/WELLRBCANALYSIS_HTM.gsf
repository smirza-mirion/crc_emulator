														     Amulet:document.btnBloodSampActivity.reappear(),
														     Amulet:document.btnPlasmaStdActivity.reappear(),
														     Amulet:document.btnPlasmaSampActivity.reappear(),
														     Amulet:document.btnPrint.reappear();
														     NAME=refreshShowPrintAndHidden">
		
