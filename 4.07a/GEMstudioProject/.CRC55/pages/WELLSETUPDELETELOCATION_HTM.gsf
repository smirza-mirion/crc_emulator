
		<META Name="Amulet" CONTENT="ReloadInternalRAM.Page"></META>
		
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0,0.01;URL=%SetScreen(%%SCREEN_WELL_SETUP_DELETE_LOC);NAME=refreshInit">
		
		<META HTTP-EQUIV="REFRESH" CONTENT="0.01;ONVAR=Amulet:internalRAM.byte(100).value();TRIGGER=0xFF;URL=Amulet:internalRAM.byte(100).setValue(0),
														     Amulet:document.sfLocation.forceUpdate(),
														     Amulet:document.sfLocation.reappear(),
														     Amulet:document.sfType.forceUpdate(),
														     Amulet:document.sfType.reappear(),
														     Amulet:document.sfThreshold.forceUpdate(),
														     Amulet:document.sfThreshold.reappear(),
														     Amulet:document.sfCountTime.forceUpdate(),
														     Amulet:document.sfCountTime.reappear(),
														     Amulet:document.btnYes.reappear(),
														     Amulet:document.btnNo.reappear();
														     NAME=refreshShow">
		
		<style type="text/css">
			#topbar {position:absolute;left:0;top:0;height:0;width:0}
			#bottombar {position:absolute;left:0;top:537;height:0;width:0}
			#title {position:absolute;left:5;top:0;width:0;height:0}
			#home {position:absolute;left:8;top:13;width:0;height:0}
			#back {position:absolute;left:693;top:13;width:0;height:0}
			#location_name_title {position:absolute;left:0;top:100;width:0;height:0}
			#location_name {position:absolute;left:200;top:100;width:0;height:0}
			#wipe_name_title {position:absolute;left:0;top:150;width:0;height:0}
			#wipe_name {position:absolute;left:200;top:150;width:0;height:0}
			#threshold_title {position:absolute;left:0;top:200;width:0;height:0}
			#threshold {position:absolute;left:200;top:200;width:0;height:0}
			#count_time_title {position:absolute;left:0;top:250;width:0;height:0}
			#count_time {position:absolute;left:200;top:250;width:0;height:0}
			#question {position:absolute;left:50;top:350;width:0;height:0}
			#yes {position:absolute;left:50;top:400;width:0;height:0}
			#no {position:absolute;left:250;top:400;width:0;height:0}
		</style>
	