		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;URL=Amulet:document.refreshTest.forceUpdate(),
			Amulet:document.btnShift.reappear();
			NAME=refreshState">

		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;IF=Amulet:internalRAM.byte(254).value();
			EQ=0;THEN=Amulet:internalRAM.byte(254).setValue(1),
					  Amulet:internalRAM.string(104).setValue('1Chr'),
					  Amulet:document.refreshUpper.forceHit();
			EQ=1;THEN=Amulet:internalRAM.byte(254).setValue(2),
			          Amulet:internalRAM.string(104).setValue('Lock');
			EQ=2;THEN=Amulet:internalRAM.byte(254).setValue(0),
			          Amulet:internalRAM.string(104).setValue('Lock'),
					  Amulet:document.refreshLower.forceHit();
		NAME=refreshTest">
														 
		<META HTTP-EQUIV="REFRESH" CONTENT="0.0;IF=Amulet:internalRAM.byte(255).value();
			EQ=0;THEN=Amulet:internalRAM.byte(255).setValue(1),
			Amulet:document.refreshShowAccent.forceUpdate();
			EQ=1;THEN=Amulet:internalRAM.byte(255).setValue(0),
			Amulet:document.refreshHideAccent.forceUpdate();
		NAME=refreshTestAccent">
														 
